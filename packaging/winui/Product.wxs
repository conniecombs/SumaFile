<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
      Id="*"
      Name="SumaFile"
      Language="1033"
      Version="$(var.ProductVersion)"
      Manufacturer="SumaFile Team"
      UpgradeCode="8F3C1B6A-4D2E-4E91-9C77-2A6B5E1D0C44">
    <Package
        InstallerVersion="200"
        Compressed="yes"
        InstallScope="perUser"
        InstallPrivileges="limited"
        Description="SumaFile WinUI host + Rust IPC service" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of SumaFile is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon.ico" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/conniecombs/SimpleFile-Windows" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="LocalProgramsFolder" Name="Programs">
          <Directory Id="INSTALLDIR" Name="SumaFile-WinUI" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="SumaFile" />
      </Directory>
    </Directory>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="B7E2C914-6A11-4F08-9D55-0C1E8A44A901">
        <Shortcut
            Id="StartMenuShortcut"
            Name="SumaFile"
            Description="SumaFile - File Explorer"
            Target="[INSTALLDIR]SumaFile.exe"
            WorkingDirectory="INSTALLDIR"
            Icon="AppIcon.ico" />
        <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue
            Root="HKCU"
            Key="Software\SumaFile\WinUI"
            Name="StartMenuShortcut"
            Type="integer"
            Value="1"
            KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="MainFeature" Title="SumaFile" Level="1">
      <ComponentGroupRef Id="SimpleFileWinUIFiles" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>
  </Product>
</Wix>
