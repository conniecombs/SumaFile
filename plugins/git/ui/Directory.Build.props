<Project>
  <!-- The Git plugin's C# projects share src-winui's build settings (warnings as errors, nullable, lock files). -->
  <Import Project="..\..\..\src-winui\Directory.Build.props" />
  <PropertyGroup>
    <!-- The plugin versions on its own; plugin.json carries the same version. -->
    <Version>1.0.0</Version>
    <InformationalVersion>1.0.0</InformationalVersion>
  </PropertyGroup>
</Project>
