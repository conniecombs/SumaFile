<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The plugin's WinUI assembly. Its UI is built in code (spec §5.3: compiled XAML from a plugin folder fails). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>SumaFile.Remote</RootNamespace>
    <AssemblyName>SumaFile.Remote</AssemblyName>
    <Description>FTP/SFTP plugin UI: the manager window, its dialogs, the Connections sidebar section and the settings page</Description>
    <IsPackable>false</IsPackable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile-only (spec §12): the SDK comes from the host at run time. -->
    <ProjectReference Include="..\..\..\..\src-winui\SimpleFile.PluginSdk\SimpleFile.PluginSdk.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <!-- The WinUI-free model ships beside this assembly in the plugin folder. -->
    <ProjectReference Include="..\SumaFile.Remote.Model\SumaFile.Remote.Model.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Compile-only (spec §5.1): WinUI and the Mvvm toolkit come from the host through PluginLoadContext's shared prefixes.
         The Model's own Mvvm reference is PrivateAssets="all", so this project needs its own for ObservableObject members. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
</Project>
