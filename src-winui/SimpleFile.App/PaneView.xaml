<UserControl
    x:Class="SimpleFile.App.PaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SimpleFile.App"
    xmlns:core="using:SimpleFile.Core"
    xmlns:ipc="using:SimpleFile.Ipc">
                        <Grid
                            x:Name="PartPaneRoot"
                            Background="{ThemeResource SfBgPrimaryBrush}"
                            BorderBrush="{ThemeResource SfBorderBrush}"
                            BorderThickness="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border
                                x:Name="PartActivePaneRail"
                                Grid.RowSpan="3"
                                Width="3"
                                HorizontalAlignment="Left"
                                Background="{ThemeResource SfAccentBrush}"
                                IsHitTestVisible="False"
                                Visibility="Collapsed" />
                            <Grid
                                x:Name="PartPaneHeader"
                                Padding="10,6,10,0"
                                Background="{ThemeResource SfBgSecondaryBrush}"
                                BorderBrush="{ThemeResource SfBorderBrush}"
                                BorderThickness="0,0,0,1"
                                ColumnSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid
                                    Grid.Row="0"
                                    ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel
                                        x:Name="PartPaneCaption"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="5"
                                        Visibility="Collapsed">
                                        <Rectangle
                                            x:Name="PartPaneCaptionRail"
                                            Width="3"
                                            Height="14"
                                            Fill="{ThemeResource SfAccentBrush}"
                                            RadiusX="1"
                                            RadiusY="1" />
                                        <TextBlock
                                            x:Name="PartPaneCaptionText"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource SfTextMutedBrush}"
                                            MaxWidth="132"
                                            TextTrimming="CharacterEllipsis"
                                            Text="Left" />
                                    </StackPanel>
                                    <ScrollViewer
                                        Grid.Column="1"
                                        HorizontalScrollBarVisibility="Auto"
                                        VerticalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="PartTabHost" Orientation="Horizontal" Spacing="2" />
                                    </ScrollViewer>
                                </Grid>
                                <Grid
                                    Grid.Row="1"
                                    Margin="0,4,0,4"
                                    ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid
                                        x:Name="PartPathBar"
                                        Grid.Column="0"
                                        MinHeight="30"
                                        Padding="6,1"
                                        Background="{ThemeResource SfBgTertiaryBrush}"
                                        BorderBrush="{ThemeResource SfBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        PointerPressed="OnPathBarPointerPressed">
                                        <ScrollViewer
                                            x:Name="PartBreadcrumbScroller"
                                            VerticalAlignment="Center"
                                            HorizontalScrollBarVisibility="Auto"
                                            VerticalScrollBarVisibility="Disabled">
                                            <StackPanel x:Name="PartBreadcrumbHost" VerticalAlignment="Center" Orientation="Horizontal" />
                                        </ScrollViewer>
                                        <TextBox
                                            x:Name="PartPathInput"
                                            Style="{StaticResource SfTextBoxStyle}"
                                            BorderThickness="0"
                                            PlaceholderText="Enter path..."
                                            Visibility="Collapsed"
                                            KeyDown="OnPathKeyDown"
                                            LostFocus="OnPathLostFocus"
                                            TextChanged="OnPathTextChanged" />
                                    </Grid>
                                    <Button
                                        x:Name="PartEditPathButton"
                                        Grid.Column="1"
                                        Style="{StaticResource SfToolbarButtonStyle}"
                                        Click="OnEditPath"
                                        AutomationProperties.Name="Edit path"
                                        ToolTipService.ToolTip="Edit path">
                                        <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="13" Glyph="&#xE70F;" />
                                    </Button>
                                </Grid>
                            </Grid>
                            <local:PaneContextBar x:Name="PartContextBar" Grid.Row="1" Visibility="Collapsed" />
                            <Grid
                                x:Name="PartFileSurface"
                                Grid.Row="2"
                                MinHeight="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ScrollViewer
                                    x:Name="PartColumnHeaderViewport"
                                    Grid.Row="0"
                                    HorizontalScrollBarVisibility="Disabled"
                                    HorizontalScrollMode="Disabled"
                                    VerticalScrollBarVisibility="Disabled"
                                    VerticalScrollMode="Disabled"
                                    ZoomMode="Disabled">
                                    <Grid
                                        x:Name="PartColumnHeader"
                                        Padding="10,0,0,0"
                                        HorizontalAlignment="Left"
                                        Background="Transparent"
                                        BorderBrush="{ThemeResource SfBorderBrush}"
                                        BorderThickness="0,0,0,1" />
                                </ScrollViewer>
                                <Grid
                                    x:Name="PartFileViewport"
                                    Grid.Row="1"
                                    Background="Transparent"
                                    PointerPressed="OnMarqueePressed"
                                    PointerMoved="OnMarqueePointerMoved"
                                    PointerReleased="OnMarqueePointerReleased"
                                    PointerCanceled="OnMarqueePointerCanceled">
                                    <local:DetailsFileListView
                                        x:Name="PartDetailsFileList"
                                        AllowDrop="True"
                                        AutomationProperties.Name="Left pane detail files"
                                        DragLeave="OnFileDragLeave"
                                        DragOver="OnFileDragOver"
                                        Drop="OnFileDrop"
                                        KeyDown="OnDetailsFileKeyDown"
                                        Visibility="Collapsed" />
                                    <ListView
                                        x:Name="PartFileList"
                                        Padding="2,4,2,6"
                                        AllowDrop="True"
                                        CanDragItems="True"
                                        AutomationProperties.Name="Left pane files"
                                        DoubleTapped="OnFileDoubleTapped"
                                        DragItemsStarting="OnFileDragItemsStarting"
                                        DragItemsCompleted="OnFileDragItemsCompleted"
                                        DragLeave="OnFileDragLeave"
                                        DragOver="OnFileDragOver"
                                        Drop="OnFileDrop"
                                        IsItemClickEnabled="False"
                                        IsMultiSelectCheckBoxEnabled="False"
                                        KeyDown="OnFileKeyDown"
                                        RightTapped="OnFileRightTapped"
                                        SelectionChanged="OnSelectionChanged"
                                        SelectionMode="Extended"
                                        SingleSelectionFollowsFocus="False">
                                        <ListView.ItemContainerStyle>
                                            <Style BasedOn="{StaticResource SfFileListItemStyle}" TargetType="ListViewItem" />
                                        </ListView.ItemContainerStyle>
                                        <ListView.ContextFlyout>
                                            <MenuFlyout Opening="OnFileListContextOpening" />
                                        </ListView.ContextFlyout>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="local:FileRow">
                                                <local:FileRowView Row="{x:Bind}" ContextRequested="OnFileRowContextRequested" />
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <Canvas x:Name="PartMarqueeCanvas" IsHitTestVisible="False">
                                        <Rectangle
                                            x:Name="PartMarqueeRect"
                                            Visibility="Collapsed"
                                            Stroke="{ThemeResource SfAccentBrush}"
                                            StrokeThickness="1"
                                            Fill="{ThemeResource SfAccentSoftBrush}"
                                            RadiusX="2"
                                            RadiusY="2" />
                                    </Canvas>
                                    <StackPanel
                                        x:Name="PartEmptyState"
                                        MaxWidth="360"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False"
                                        Spacing="6"
                                        Visibility="Collapsed">
                                        <TextBlock
                                            x:Name="PartEmptyTitle"
                                            HorizontalAlignment="Center"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource SfTextPrimaryBrush}"
                                            Text="This folder is empty"
                                            TextAlignment="Center" />
                                        <TextBlock
                                            x:Name="PartEmptyHint"
                                            HorizontalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{ThemeResource SfTextMutedBrush}"
                                            Text="Drop files here, or press Ctrl+Shift+N to create a folder"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                                <ScrollBar
                                    x:Name="PartDetailsHorizontalScrollBar"
                                    Grid.Row="2"
                                    Height="12"
                                    Orientation="Horizontal"
                                    Visibility="Collapsed"
                                    ValueChanged="OnDetailsHorizontalScrollChanged" />
                            </Grid>
                        </Grid>
</UserControl>
