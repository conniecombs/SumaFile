<ContentDialog
    x:Class="SimpleFile.App.ExtractArchiveDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Extract Archive"
    PrimaryButtonText="Extract"
    SecondaryButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel Spacing="16" Width="400">
        <!-- Summary Info -->
        <StackPanel Spacing="4">
            <TextBlock Text="Archive to extract:" FontWeight="SemiBold" />
            <TextBlock x:Name="ArchiveNameText" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Contents:" FontWeight="SemiBold" />
            <TextBlock x:Name="ContentsText" Foreground="{ThemeResource SfTextMutedBrush}" />
        </StackPanel>

        <InfoBar x:Name="WarningBar" Severity="Warning" IsOpen="False" IsClosable="False" />

        <StackPanel Spacing="8">
            <TextBlock Text="Destination:" FontWeight="SemiBold" />
            <RadioButton x:Name="RadioHere" Content="Extract Here" Tag="here" IsChecked="True" Checked="OnRadioChecked" />
            <RadioButton x:Name="RadioSubfolder" Content="Extract to Folder" Tag="subfolder" Checked="OnRadioChecked" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <RadioButton x:Name="RadioCustom" Content="Extract to..." Tag="custom" Checked="OnRadioChecked" VerticalAlignment="Center" />
                <Button x:Name="BrowseButton" Content="Browse" IsEnabled="False" Click="OnBrowseClicked" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="DestinationText" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource SfTextMutedBrush}" Margin="24,0,0,0" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
