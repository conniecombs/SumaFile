<ContentDialog
    x:Class="SimpleFile.App.TagPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Select a Tag"
    PrimaryButtonText="Apply"
    SecondaryButtonText="Cancel"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    SecondaryButtonClick="ContentDialog_SecondaryButtonClick">

    <Grid Width="300" Height="400">
        <StackPanel Spacing="8">
            <RadioButton x:Name="NoTagRadio" Content="None (Remove Label)" GroupName="TagsGroup" Margin="0,0,0,8" />
            <ListView x:Name="TagsList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <RadioButton GroupName="TagsGroup" IsChecked="{Binding IsSelected, Mode=TwoWay}" Tag="{Binding Id}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Ellipse Width="16" Height="16" Fill="{Binding ColorBrush}" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Grid>
</ContentDialog>
