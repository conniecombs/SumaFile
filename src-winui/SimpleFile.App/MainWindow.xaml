<Window
    x:Class="SimpleFile.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SimpleFile.App"
    xmlns:core="using:SimpleFile.Core"
    xmlns:ipc="using:SimpleFile.Ipc"
    Title="SumaFile">
    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        PreviewKeyDown="OnRootPreviewKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarHost" Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="CaptionButtonSpacer" Width="138" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="AppTitleBar">
                <StackPanel
                    Margin="16,0,12,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Image
                        Width="18"
                        Height="18"
                        AutomationProperties.Name="SumaFile icon"
                        Source="ms-appx:///SumaFile.png"
                        Stretch="Uniform" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource SfTextPrimaryBrush}"
                        Text="SumaFile" />
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="1" Background="{ThemeResource SfBgSecondaryBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="232" MinWidth="180" MaxWidth="520" />
                <ColumnDefinition x:Name="SidebarDividerColumn" Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <local:SidebarView x:Name="SidebarPanel" Grid.Column="0" />

            <local:PaneResizeGrip
                x:Name="SidebarDivider"
                Grid.Column="1"
                AutomationProperties.Name="Resize sidebar"
                DoubleTapped="OnSidebarDividerDoubleTapped"
                PointerMoved="OnSidebarDividerMoved"
                PointerPressed="OnSidebarDividerPressed"
                PointerReleased="OnSidebarDividerReleased">
                <Rectangle
                    Width="1"
                    HorizontalAlignment="Center"
                    Fill="{ThemeResource SfBorderBrush}" />
            </local:PaneResizeGrip>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <InfoBar
                    x:Name="MessageBar"
                    Margin="10,8,10,0"
                    IsClosable="True"
                    IsOpen="False"
                    Severity="Informational" />

                <Grid x:Name="ExplorerContentGrid" Grid.Row="1" SizeChanged="OnExplorerContentSizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="240" />
                        <ColumnDefinition x:Name="PreviewDividerColumn" Width="8" />
                        <ColumnDefinition x:Name="PreviewColumn" Width="296" MinWidth="200" MaxWidth="720" />
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="FilePaneShell" Grid.Column="0" SizeChanged="OnPluginPanelHostSizeChanged">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <local:PrimaryToolbarView x:Name="PrimaryToolbarPanel" Grid.Row="0" />

                        <!-- Spec §7's PluginPanelHost: the right region and its grip beside the panes (MainWindow.PluginPanels.cs). -->
                        <Grid x:Name="PanesAndPanelGrid" Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="PluginPanelRightGripColumn" Width="0" />
                            <ColumnDefinition x:Name="PluginPanelRightColumn" Width="0" />
                        </Grid.ColumnDefinitions>

                        <Grid x:Name="PanesGrid" Grid.Column="0" SizeChanged="OnPanesGridSizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="PrimaryColumn" Width="*" />
                            <ColumnDefinition x:Name="DividerColumn" Width="0" />
                            <ColumnDefinition x:Name="SecondaryColumn" Width="0" />
                        </Grid.ColumnDefinitions>

                        <local:PaneView x:Name="PrimaryPane" Pane="Primary" Grid.Column="0" />

                        <local:PaneResizeGrip
                            x:Name="PaneDivider"
                            Grid.Column="1"
                            AutomationProperties.Name="Resize left and right panes"
                            DoubleTapped="OnDividerDoubleTapped"
                            PointerMoved="OnDividerMoved"
                            PointerPressed="OnDividerPressed"
                            PointerReleased="OnDividerReleased"
                            Visibility="Collapsed">
                            <Rectangle
                                Width="1"
                                HorizontalAlignment="Center"
                                Fill="{ThemeResource SfBorderBrush}" />
                        </local:PaneResizeGrip>

                        <local:PaneView x:Name="SecondaryPane" Pane="Secondary" Grid.Column="2" />
                    </Grid>

                        <local:PaneResizeGrip
                            x:Name="PluginPanelRightGrip"
                            Grid.Column="1"
                            AutomationProperties.AutomationId="PluginPanel.RightGrip"
                            AutomationProperties.Name="Resize plugin panel"
                            DoubleTapped="OnPluginPanelGripDoubleTapped"
                            PointerMoved="OnPluginPanelGripMoved"
                            PointerPressed="OnPluginPanelGripPressed"
                            PointerReleased="OnPluginPanelGripReleased"
                            Visibility="Collapsed">
                            <Rectangle
                                Width="1"
                                HorizontalAlignment="Center"
                                Fill="{ThemeResource SfBorderBrush}" />
                        </local:PaneResizeGrip>

                        <Border
                            x:Name="PluginPanelRightRegion"
                            Grid.Column="2"
                            Background="{ThemeResource SfBgSecondaryBrush}"
                            Visibility="Collapsed" />
                        </Grid>

                        <!-- Spec §7's PluginPanelHost: the bottom region and its grip (MainWindow.PluginPanels.cs). -->
                        <Grid
                            x:Name="PluginPanelBottomRegion"
                            Grid.Row="2"
                            Background="{ThemeResource SfBgSecondaryBrush}"
                            Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <local:RowResizeGrip
                                x:Name="PluginPanelBottomGrip"
                                Grid.Row="0"
                                AutomationProperties.AutomationId="PluginPanel.BottomGrip"
                                AutomationProperties.Name="Resize plugin panel"
                                DoubleTapped="OnPluginPanelGripDoubleTapped"
                                PointerMoved="OnPluginPanelGripMoved"
                                PointerPressed="OnPluginPanelGripPressed"
                                PointerReleased="OnPluginPanelGripReleased">
                                <Rectangle
                                    Height="1"
                                    VerticalAlignment="Center"
                                    Fill="{ThemeResource SfBorderBrush}" />
                            </local:RowResizeGrip>

                            <Border x:Name="PluginPanelBottomHost" Grid.Row="1" />
                        </Grid>
                    </Grid>

                    <local:PaneResizeGrip
                        x:Name="PreviewDivider"
                        Grid.Column="1"
                        AutomationProperties.Name="Resize preview pane"
                        DoubleTapped="OnPreviewDividerDoubleTapped"
                        PointerMoved="OnPreviewDividerMoved"
                        PointerPressed="OnPreviewDividerPressed"
                        PointerReleased="OnPreviewDividerReleased">
                        <Rectangle
                            Width="1"
                            HorizontalAlignment="Center"
                            Fill="{ThemeResource SfBorderBrush}" />
                    </local:PaneResizeGrip>

                    <local:PreviewPaneView x:Name="PreviewPanel" Grid.Column="2" />
                    <Button x:Name="PreviewRail" Grid.Column="2" Visibility="Collapsed"
                        VerticalAlignment="Top" Margin="2,8" Padding="6,10"
                        Style="{StaticResource SfGhostButtonStyle}" Click="OnExpandPreview"
                        AutomationProperties.Name="Open preview" ToolTipService.ToolTip="Open preview">
                        <FontIcon FontFamily="{StaticResource SfIconFont}" Glyph="&#xE8A7;" FontSize="16" />
                    </Button>
                </Grid>

                <Grid
                    Grid.Row="2"
                    Padding="12,4"
                    Background="{ThemeResource SfBgSecondaryBrush}"
                    BorderBrush="{ThemeResource SfBorderBrush}"
                    BorderThickness="0,1,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="StatusText"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource SfTextMutedBrush}"
                        Text="Starting SumaFile's file service..."
                        TextTrimming="CharacterEllipsis" />
                    <Button
                        x:Name="StatusCenterButton"
                        Grid.Column="1"
                        Style="{StaticResource SfGhostButtonStyle}"
                        MinHeight="26"
                        Margin="8,0"
                        Padding="8,3"
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="Status Center"
                        ToolTipService.ToolTip="Status Center">
                        <Button.Flyout>
                            <Flyout Opening="OnStatusCenterFlyoutOpening">
                                <StackPanel Width="320" Padding="4" Spacing="10">
                                    <TextBlock
                                        x:Name="StatusCenterHeaderText"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource SfTextPrimaryBrush}"
                                        Text="No active tasks"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="StatusCenterDetailText"
                                        Foreground="{ThemeResource SfTextMutedBrush}"
                                        Text="SumaFile is ready."
                                        TextWrapping="Wrap" />
                                    <ListView
                                        x:Name="StatusCenterTaskList"
                                        MaxHeight="220"
                                        SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="0,4" ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon
                                                        VerticalAlignment="Top"
                                                        FontFamily="{StaticResource SfIconFont}"
                                                        FontSize="12"
                                                        Foreground="{ThemeResource SfTextMutedBrush}"
                                                        Glyph="&#xE9D9;" />
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock
                                                            Foreground="{ThemeResource SfTextPrimaryBrush}"
                                                            Text="{Binding Title}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            FontSize="12"
                                                            Foreground="{ThemeResource SfTextMutedBrush}"
                                                            Text="{Binding Detail}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        FontSize="12"
                                                        Foreground="{ThemeResource SfTextMutedBrush}"
                                                        Text="{Binding Badge}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <StackPanel Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button
                                                MinHeight="30"
                                                Padding="10,4"
                                                Click="OnStatusCenterTransfersClick">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon
                                                        FontFamily="{StaticResource SfIconFont}"
                                                        FontSize="11"
                                                        Glyph="&#xE9D9;" />
                                                    <TextBlock Text="Transfers" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                MinHeight="30"
                                                Padding="10,4"
                                                Click="OnStatusCenterHistoryClick">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon
                                                        FontFamily="{StaticResource SfIconFont}"
                                                        FontSize="11"
                                                        Glyph="&#xE81C;" />
                                                    <TextBlock Text="History" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button
                                                x:Name="StatusCenterCancelTransferButton"
                                                MinHeight="30"
                                                Padding="10,4"
                                                Click="OnStatusCenterCancelTransferClick"
                                                IsEnabled="False"
                                                ToolTipService.ToolTip="Cancel the first active transfer">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon
                                                        FontFamily="{StaticResource SfIconFont}"
                                                        FontSize="11"
                                                        Glyph="&#xE711;" />
                                                    <TextBlock Text="Cancel" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                x:Name="StatusCenterClearCompletedButton"
                                                MinHeight="30"
                                                Padding="10,4"
                                                Click="OnStatusCenterClearCompletedClick"
                                                IsEnabled="False"
                                                ToolTipService.ToolTip="Clear completed transfers">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon
                                                        FontFamily="{StaticResource SfIconFont}"
                                                        FontSize="11"
                                                        Glyph="&#xE74D;" />
                                                    <TextBlock Text="Clear" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon
                                FontFamily="{StaticResource SfIconFont}"
                                FontSize="12"
                                Glyph="&#xE9D9;" />
                            <TextBlock x:Name="StatusCenterBadgeText" FontSize="12" Text="Idle" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="PreviewToggleButton"
                        Grid.Column="2"
                        Style="{StaticResource SfGhostButtonStyle}"
                        MinHeight="26"
                        Margin="8,0"
                        Padding="8,3"
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="Toggle preview pane"
                        Click="OnTogglePreview"
                        ToolTipService.ToolTip="Toggle preview pane">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon
                                FontFamily="{StaticResource SfIconFont}"
                                FontSize="12"
                                Glyph="&#xE8FF;" />
                            <TextBlock FontSize="12" Text="Preview" />
                        </StackPanel>
                    </Button>
                    <TextBlock
                        x:Name="CountText"
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource SfTextMutedBrush}" />
                </Grid>
            </Grid>
        </Grid>

        <Grid
            x:Name="CommandPaletteOverlay"
            Grid.RowSpan="2"
            Background="#99000000"
            Visibility="Collapsed"
            PointerPressed="OnCommandPaletteOverlayPressed">
            <Border
                Width="560"
                MaxHeight="420"
                Margin="0,72,0,0"
                Padding="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="{ThemeResource SfBgPrimaryBrush}"
                BorderBrush="{ThemeResource SfBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                PointerPressed="OnCommandPaletteInnerPressed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBox
                        x:Name="CommandPaletteInput"
                        Style="{StaticResource SfTextBoxStyle}"
                        AutomationProperties.Name="Command palette"
                        PlaceholderText="Type a command..."
                        TextChanged="OnCommandPaletteTextChanged"
                        KeyDown="OnCommandPaletteKeyDown" />
                    <ListView
                        x:Name="CommandPaletteList"
                        Grid.Row="1"
                        Margin="0,8,0,0"
                        AutomationProperties.Name="Commands"
                        IsItemClickEnabled="True"
                        ItemClick="OnCommandPaletteItemClick"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="core:AppCommand">
                                <Grid Padding="4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{ThemeResource SfTextPrimaryBrush}" Text="{x:Bind Label}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        FontSize="12"
                                        Foreground="{ThemeResource SfTextMutedBrush}"
                                        Text="{x:Bind Shortcut}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
