<Window
    x:Class="SimpleFile.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SimpleFile.App"
    xmlns:core="using:SimpleFile.Core"
    xmlns:ipc="using:SimpleFile.Ipc"
    Title="SumaFile">
    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        PreviewKeyDown="OnRootPreviewKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarHost" Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="CaptionButtonSpacer" Width="138" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="AppTitleBar">
                <StackPanel
                    Margin="16,0,12,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Image
                        Width="18"
                        Height="18"
                        AutomationProperties.Name="SumaFile icon"
                        Source="ms-appx:///SumaFile.png"
                        Stretch="Uniform" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource SfTextPrimaryBrush}"
                        Text="SumaFile" />
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="1" Background="{ThemeResource SfBgPrimaryBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="232" MinWidth="180" MaxWidth="520" />
                <ColumnDefinition x:Name="SidebarDividerColumn" Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <local:SidebarView x:Name="SidebarPanel" Grid.Column="0" />

            <local:PaneResizeGrip
                x:Name="SidebarDivider"
                Grid.Column="1"
                AutomationProperties.Name="Resize sidebar"
                DoubleTapped="OnSidebarDividerDoubleTapped"
                PointerMoved="OnSidebarDividerMoved"
                PointerPressed="OnSidebarDividerPressed"
                PointerReleased="OnSidebarDividerReleased">
                <Rectangle
                    Width="1"
                    HorizontalAlignment="Center"
                    Fill="{ThemeResource SfBorderBrush}" />
            </local:PaneResizeGrip>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <InfoBar
                    x:Name="MessageBar"
                    Margin="10,8,10,0"
                    IsClosable="True"
                    IsOpen="False"
                    Severity="Informational" />

                <Grid x:Name="ExplorerContentGrid" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="240" />
                        <ColumnDefinition x:Name="PreviewDividerColumn" Width="8" />
                        <ColumnDefinition x:Name="PreviewColumn" Width="296" MinWidth="200" MaxWidth="720" />
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="FilePaneShell" Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <local:PrimaryToolbarView x:Name="PrimaryToolbarPanel" Grid.Row="0" />

                        <Grid x:Name="PanesGrid" Grid.Row="1" SizeChanged="OnPanesGridSizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="PrimaryColumn" Width="*" />
                            <ColumnDefinition x:Name="DividerColumn" Width="0" />
                            <ColumnDefinition x:Name="SecondaryColumn" Width="0" />
                        </Grid.ColumnDefinitions>

                        <local:PrimaryPaneView x:Name="PrimaryPane" Grid.Column="0" />

                        <local:PaneResizeGrip
                            x:Name="PaneDivider"
                            Grid.Column="1"
                            AutomationProperties.Name="Resize left and right panes"
                            DoubleTapped="OnDividerDoubleTapped"
                            PointerMoved="OnDividerMoved"
                            PointerPressed="OnDividerPressed"
                            PointerReleased="OnDividerReleased"
                            Visibility="Collapsed">
                            <Rectangle
                                Width="1"
                                HorizontalAlignment="Center"
                                Fill="{ThemeResource SfBorderBrush}" />
                        </local:PaneResizeGrip>

                        <local:SecondaryPaneView x:Name="SecondaryPane" Grid.Column="2" />
                    </Grid>

                        <Border
                            x:Name="GitPanel"
                            Grid.Row="2"
                            MinHeight="176"
                            MaxHeight="320"
                            Padding="12"
                            Background="{ThemeResource SfBgSecondaryBrush}"
                            BorderBrush="{ThemeResource SfBorderBrush}"
                            BorderThickness="0,1,0,0"
                            Visibility="Collapsed">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource SfIconFont}"
                                        FontSize="16"
                                        Foreground="{ThemeResource SfAccentBrush}"
                                        Glyph="&#xE8EF;" />
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock
                                            x:Name="GitBranchText"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource SfTextPrimaryBrush}"
                                            Text="Git" />
                                        <TextBlock
                                            x:Name="GitSummaryText"
                                            FontSize="12"
                                            Foreground="{ThemeResource SfTextMutedBrush}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button
                                        x:Name="GitCloseButton"
                                        Grid.Column="2"
                                        Width="30"
                                        Height="30"
                                        MinWidth="30"
                                        Padding="0"
                                        Style="{StaticResource SfGhostButtonStyle}"
                                        AutomationProperties.Name="Close Git panel"
                                        Click="OnCloseGitPanel"
                                        ToolTipService.ToolTip="Close Git panel">
                                        <FontIcon
                                            FontFamily="{StaticResource SfIconFont}"
                                            FontSize="12"
                                            Glyph="&#xE711;" />
                                    </Button>
                                </Grid>

                                <ListView
                                    x:Name="GitChangesList"
                                    Grid.Row="1"
                                    MinHeight="72"
                                    AutomationProperties.Name="Git changes"
                                    SelectionChanged="OnGitChangesSelectionChanged"
                                    SelectionMode="Extended">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid MinHeight="34" Padding="8,5" ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="92" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource SfTextPrimaryBrush}"
                                                    Text="{Binding StatusText}" />
                                                <StackPanel Grid.Column="1" Spacing="1">
                                                    <TextBlock
                                                        FontSize="12"
                                                        Foreground="{ThemeResource SfTextPrimaryBrush}"
                                                        Text="{Binding Path}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{ThemeResource SfTextMutedBrush}"
                                                        Text="{Binding DetailText}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Foreground="{ThemeResource SfTextMutedBrush}"
                                                    Text="{Binding StageText}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <Grid Grid.Row="2" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="GitRefreshButton" Grid.Column="0" Style="{StaticResource SfGhostButtonStyle}" Click="OnGitRefresh" ToolTipService.ToolTip="Refresh Git status">
                                        <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="12" Glyph="&#xE72C;" />
                                    </Button>
                                    <Button x:Name="GitFetchButton" Grid.Column="1" Style="{StaticResource SfGhostButtonStyle}" Click="OnGitFetch" ToolTipService.ToolTip="Fetch">
                                        <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="12" Glyph="&#xE8B5;" />
                                    </Button>
                                    <Button x:Name="GitPullButton" Grid.Column="2" Style="{StaticResource SfGhostButtonStyle}" Click="OnGitPull" ToolTipService.ToolTip="Pull">
                                        <TextBlock FontSize="12" Text="Pull" />
                                    </Button>
                                    <Button x:Name="GitPushButton" Grid.Column="3" Style="{StaticResource SfGhostButtonStyle}" Click="OnGitPush" ToolTipService.ToolTip="Push">
                                        <TextBlock FontSize="12" Text="Push" />
                                    </Button>
                                    <Button x:Name="GitCommitButton" Grid.Column="4" Style="{StaticResource SfGhostButtonStyle}" Click="OnGitCommit" ToolTipService.ToolTip="Commit staged changes">
                                        <TextBlock FontSize="12" Text="Commit" />
                                    </Button>
                                    <Button x:Name="GitStageButton" Grid.Column="6" Style="{StaticResource SfGhostButtonStyle}" Click="OnGitStageSelected" ToolTipService.ToolTip="Stage selected changes">
                                        <TextBlock FontSize="12" Text="Stage" />
                                    </Button>
                                    <Button x:Name="GitUnstageButton" Grid.Column="7" Style="{StaticResource SfGhostButtonStyle}" Click="OnGitUnstageSelected" ToolTipService.ToolTip="Unstage selected changes">
                                        <TextBlock FontSize="12" Text="Unstage" />
                                    </Button>
                                    <Button x:Name="GitDiscardButton" Grid.Column="8" Style="{StaticResource SfGhostButtonStyle}" Click="OnGitDiscardSelected" ToolTipService.ToolTip="Discard selected changes">
                                        <TextBlock FontSize="12" Text="Discard" />
                                    </Button>
                                    <Button x:Name="GitDiffButton" Grid.Column="9" Style="{StaticResource SfGhostButtonStyle}" Click="OnGitDiffSelected" ToolTipService.ToolTip="Show selected diff">
                                        <TextBlock FontSize="12" Text="Diff" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <local:PaneResizeGrip
                        x:Name="PreviewDivider"
                        Grid.Column="1"
                        AutomationProperties.Name="Resize preview pane"
                        DoubleTapped="OnPreviewDividerDoubleTapped"
                        PointerMoved="OnPreviewDividerMoved"
                        PointerPressed="OnPreviewDividerPressed"
                        PointerReleased="OnPreviewDividerReleased">
                        <Rectangle
                            Width="1"
                            HorizontalAlignment="Center"
                            Fill="{ThemeResource SfBorderBrush}" />
                    </local:PaneResizeGrip>

                    <local:PreviewPaneView x:Name="PreviewPanel" Grid.Column="2" />
                </Grid>

                <Grid
                    Grid.Row="2"
                    Padding="12,6"
                    Background="{ThemeResource SfBgSecondaryBrush}"
                    BorderBrush="{ThemeResource SfBorderBrush}"
                    BorderThickness="0,1,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="StatusText"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource SfTextMutedBrush}"
                        Text="Starting SumaFile service..."
                        TextTrimming="CharacterEllipsis" />
                    <Button
                        x:Name="GitToggleButton"
                        Grid.Column="1"
                        Style="{StaticResource SfGhostButtonStyle}"
                        MinHeight="26"
                        Margin="8,0"
                        Padding="8,3"
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="Toggle Git panel"
                        Click="OnToggleGitPanel"
                        ToolTipService.ToolTip="Toggle Git panel">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon
                                FontFamily="{StaticResource SfIconFont}"
                                FontSize="12"
                                Glyph="&#xE8EF;" />
                            <TextBlock FontSize="12" Text="Git" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="PreviewToggleButton"
                        Grid.Column="2"
                        Style="{StaticResource SfGhostButtonStyle}"
                        MinHeight="26"
                        Margin="8,0"
                        Padding="8,3"
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="Toggle preview pane"
                        Click="OnTogglePreview"
                        ToolTipService.ToolTip="Toggle preview pane">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon
                                FontFamily="{StaticResource SfIconFont}"
                                FontSize="12"
                                Glyph="&#xE8FF;" />
                            <TextBlock FontSize="12" Text="Preview" />
                        </StackPanel>
                    </Button>
                    <TextBlock
                        x:Name="CountText"
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource SfTextMutedBrush}" />
                </Grid>
            </Grid>
        </Grid>

        <Grid
            x:Name="CommandPaletteOverlay"
            Grid.RowSpan="2"
            Background="#99000000"
            Visibility="Collapsed"
            PointerPressed="OnCommandPaletteOverlayPressed">
            <Border
                Width="560"
                MaxHeight="420"
                Margin="0,72,0,0"
                Padding="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="{ThemeResource SfBgPrimaryBrush}"
                BorderBrush="{ThemeResource SfBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                PointerPressed="OnCommandPaletteInnerPressed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBox
                        x:Name="CommandPaletteInput"
                        Style="{StaticResource SfTextBoxStyle}"
                        AutomationProperties.Name="Command palette"
                        PlaceholderText="Type a command..."
                        TextChanged="OnCommandPaletteTextChanged"
                        KeyDown="OnCommandPaletteKeyDown" />
                    <ListView
                        x:Name="CommandPaletteList"
                        Grid.Row="1"
                        Margin="0,8,0,0"
                        AutomationProperties.Name="Commands"
                        IsItemClickEnabled="True"
                        ItemClick="OnCommandPaletteItemClick"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="core:AppCommand">
                                <Grid Padding="4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{ThemeResource SfTextPrimaryBrush}" Text="{x:Bind Label}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        FontSize="12"
                                        Foreground="{ThemeResource SfTextMutedBrush}"
                                        Text="{x:Bind Shortcut}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
