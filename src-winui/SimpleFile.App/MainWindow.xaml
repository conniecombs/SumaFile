<Window
    x:Class="SimpleFile.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SimpleFile.App"
    xmlns:core="using:SimpleFile.Core"
    xmlns:ipc="using:SimpleFile.Ipc"
    Title="SumaFile">
    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        PreviewKeyDown="OnRootPreviewKeyDown">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F5" Invoked="OnRefreshAccelerator" />
            <KeyboardAccelerator Key="F6" Invoked="OnDualPaneAccelerator" />
            <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="OnBackAccelerator" />
            <KeyboardAccelerator Key="Right" Modifiers="Menu" Invoked="OnForwardAccelerator" />
            <KeyboardAccelerator Key="Up" Modifiers="Menu" Invoked="OnUpAccelerator" />
            <KeyboardAccelerator Key="Number1" Modifiers="Menu" Invoked="OnFocusPrimaryAccelerator" />
            <KeyboardAccelerator Key="Number2" Modifiers="Menu" Invoked="OnFocusSecondaryAccelerator" />
            <KeyboardAccelerator Key="T" Modifiers="Control" Invoked="OnNewTabAccelerator" />
            <KeyboardAccelerator Key="W" Modifiers="Control" Invoked="OnCloseTabAccelerator" />
            <KeyboardAccelerator Key="Tab" Modifiers="Control" Invoked="OnNextTabAccelerator" />
            <KeyboardAccelerator Key="Tab" Modifiers="Control,Shift" Invoked="OnPreviousTabAccelerator" />
            <KeyboardAccelerator Key="Left" Modifiers="Control,Shift" Invoked="OnFocusPrimaryAccelerator" />
            <KeyboardAccelerator Key="Right" Modifiers="Control,Shift" Invoked="OnFocusSecondaryAccelerator" />
            <KeyboardAccelerator Key="N" Modifiers="Control,Shift" Invoked="OnNewFolderAccelerator" />
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="OnNewFileAccelerator" />
            <KeyboardAccelerator Key="F2" Invoked="OnRenameAccelerator" />
            <KeyboardAccelerator Key="Enter" Modifiers="Menu" Invoked="OnPropertiesAccelerator" />
            <KeyboardAccelerator Key="Enter" Modifiers="Control" Invoked="OnOpenInNewTabAccelerator" />
            <KeyboardAccelerator Key="H" Modifiers="Control" Invoked="OnToggleHiddenAccelerator" />
            <KeyboardAccelerator Key="B" Modifiers="Control" Invoked="OnBookmarkAccelerator" />
            <KeyboardAccelerator Key="F3" Invoked="OnFocusSearchAccelerator" />
            <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="OnTab1Accelerator" />
            <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="OnTab2Accelerator" />
            <KeyboardAccelerator Key="Number3" Modifiers="Control" Invoked="OnTab3Accelerator" />
            <KeyboardAccelerator Key="Number4" Modifiers="Control" Invoked="OnTab4Accelerator" />
            <KeyboardAccelerator Key="Number5" Modifiers="Control" Invoked="OnTab5Accelerator" />
            <KeyboardAccelerator Key="Number6" Modifiers="Control" Invoked="OnTab6Accelerator" />
            <KeyboardAccelerator Key="Number7" Modifiers="Control" Invoked="OnTab7Accelerator" />
            <KeyboardAccelerator Key="Number8" Modifiers="Control" Invoked="OnTab8Accelerator" />
            <KeyboardAccelerator Key="Number9" Modifiers="Control" Invoked="OnTab9Accelerator" />
            <KeyboardAccelerator Key="Delete" Modifiers="Shift" Invoked="OnDeleteAccelerator" />
            <KeyboardAccelerator Key="Delete" Invoked="OnTrashAccelerator" />
            <KeyboardAccelerator Key="C" Modifiers="Control" Invoked="OnCopyAccelerator" />
            <KeyboardAccelerator Key="X" Modifiers="Control" Invoked="OnCutAccelerator" />
            <KeyboardAccelerator Key="V" Modifiers="Control" Invoked="OnPasteAccelerator" />
            <KeyboardAccelerator Key="F4" Invoked="OnOpenTerminalAccelerator" />
            <KeyboardAccelerator Key="S" Modifiers="Control,Shift" Invoked="OnSettingsAccelerator" />
            <KeyboardAccelerator Key="P" Modifiers="Control,Shift" Invoked="OnCommandPaletteAccelerator" />
            <KeyboardAccelerator Key="L" Modifiers="Control" Invoked="OnFocusPathAccelerator" />
            <KeyboardAccelerator Key="D" Modifiers="Menu" Invoked="OnFocusPathAccelerator" />
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnFocusSearchAccelerator" />
            <KeyboardAccelerator Key="A" Modifiers="Control" Invoked="OnSelectAllAccelerator" />
            <KeyboardAccelerator Key="C" Modifiers="Control,Shift" Invoked="OnCopyPathAccelerator" />
            <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="OnUndoAccelerator" />
            <KeyboardAccelerator Key="Y" Modifiers="Control" Invoked="OnRedoAccelerator" />
            <KeyboardAccelerator Key="Z" Modifiers="Control,Shift" Invoked="OnRedoAccelerator" />
            <KeyboardAccelerator Key="F1" Invoked="OnKeyboardHelpAccelerator" />
            <KeyboardAccelerator Key="Divide" Modifiers="Control" Invoked="OnKeyboardHelpAccelerator" />
            <KeyboardAccelerator Key="C" Modifiers="Control,Menu" Invoked="OnCopyToOtherPaneAccelerator" />
            <KeyboardAccelerator Key="M" Modifiers="Control,Menu" Invoked="OnMoveToOtherPaneAccelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarHost" Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="CaptionButtonSpacer" Width="138" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="AppTitleBar">
                <StackPanel
                    Margin="16,0,12,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Image
                        Width="18"
                        Height="18"
                        AutomationProperties.Name="SumaFile icon"
                        Source="ms-appx:///SumaFile.png"
                        Stretch="Uniform" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource SfTextPrimaryBrush}"
                        Text="SumaFile" />
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="1" Background="{ThemeResource SfBgPrimaryBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="232" MinWidth="180" MaxWidth="520" />
                <ColumnDefinition x:Name="SidebarDividerColumn" Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid
                x:Name="SidebarRoot"
                Grid.Column="0"
                Background="{ThemeResource SfBgSecondaryBrush}"
                BorderBrush="{ThemeResource SfBorderBrush}"
                BorderThickness="0,0,1,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="8,8,8,0" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        x:Name="SidebarTargetSwitch"
                        Padding="2"
                        Background="{ThemeResource SfBgTertiaryBrush}"
                        BorderBrush="{ThemeResource SfBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="Collapsed">
                        <Grid ColumnSpacing="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="SidebarLeftButton"
                                Style="{StaticResource SfGhostButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Click="OnSidebarLeft"
                                Content="Left"
                                ToolTipService.ToolTip="Navigate left pane" />
                            <Button
                                x:Name="SidebarRightButton"
                                Grid.Column="1"
                                Style="{StaticResource SfGhostButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Click="OnSidebarRight"
                                Content="Right"
                                ToolTipService.ToolTip="Navigate right pane" />
                        </Grid>
                    </Border>
                    <Button
                        x:Name="SidebarCloseButton"
                        Grid.Column="1"
                        Style="{StaticResource SfSidebarIconButtonStyle}"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="Hide side menu"
                        Click="OnToggleSidebar"
                        ToolTipService.ToolTip="Hide side menu">
                        <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="11" Glyph="&#xE711;" />
                    </Button>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="10,8,10,14" Spacing="10">
                        <StackPanel x:Name="QuickAccessSection" Spacing="2">
                            <Grid Margin="4,0,0,4">
                                <TextBlock Style="{StaticResource SfSidebarHeaderStyle}" Text="Quick access" />
                                <Button
                                    x:Name="QuickAccessCollapseButton"
                                    Style="{StaticResource SfSidebarIconButtonStyle}"
                                    AutomationProperties.Name="Collapse Quick Access"
                                    Click="OnToggleQuickAccess">
                                    <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="10" Glyph="&#xE70D;" />
                                </Button>
                            </Grid>
                            <ListView
                                x:Name="QuickAccessList"
                                Style="{StaticResource SfSidebarListStyle}"
                                IsItemClickEnabled="True"
                                ItemClick="OnQuickAccessClick"
                                SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style BasedOn="{StaticResource SfNavListItemStyle}" TargetType="ListViewItem" />
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:QuickAccessRow">
                                        <StackPanel Orientation="Horizontal" Padding="2,1" Spacing="10">
                                            <local:ShellIconImage
                                                Width="16"
                                                Height="16"
                                                VerticalAlignment="Center"
                                                Path="{x:Bind Path}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource SfTextPrimaryBrush}"
                                                Text="{x:Bind Name}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <Grid Margin="4,0,0,4">
                                <TextBlock Style="{StaticResource SfSidebarHeaderStyle}" Text="This PC" />
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="2">
                                    <Button
                                        x:Name="RefreshDrivesButton"
                                        Style="{StaticResource SfSidebarIconButtonStyle}"
                                        AutomationProperties.Name="Refresh drives"
                                        Click="OnRefreshDrives"
                                        ToolTipService.ToolTip="Refresh drives and mapped network status">
                                        <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="11" Glyph="&#xE72C;" />
                                    </Button>
                                    <Button
                                        x:Name="MyPcCollapseButton"
                                        Style="{StaticResource SfSidebarIconButtonStyle}"
                                        AutomationProperties.Name="Collapse My PC"
                                        Click="OnToggleMyPc">
                                        <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="10" Glyph="&#xE70D;" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <ListView
                                x:Name="DriveList"
                                Style="{StaticResource SfSidebarListStyle}"
                                IsItemClickEnabled="True"
                                ItemClick="OnDriveClick"
                                SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style BasedOn="{StaticResource SfDriveListItemStyle}" TargetType="ListViewItem" />
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:DriveRow">
                                        <Grid
                                            Padding="0,1"
                                            ColumnSpacing="10"
                                            AutomationProperties.Name="{x:Bind AutomationName}"
                                            Opacity="{x:Bind RowOpacity}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <local:ShellIconImage
                                                Width="16"
                                                Height="16"
                                                VerticalAlignment="Top"
                                                Margin="0,2,0,0"
                                                Path="{x:Bind Path}" />
                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        Foreground="{ThemeResource SfTextPrimaryBrush}"
                                                        Text="{x:Bind Name}"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="NoWrap" />
                                                    <Border
                                                        Grid.Column="1"
                                                        Padding="5,1"
                                                        VerticalAlignment="Center"
                                                        Background="{ThemeResource SfAccentSoftBrush}"
                                                        BorderThickness="0"
                                                        CornerRadius="4"
                                                        Visibility="{x:Bind BadgeVisibility}">
                                                        <TextBlock
                                                            FontSize="10"
                                                            Foreground="{ThemeResource SfTextPrimaryBrush}"
                                                            Text="{x:Bind Badge}" />
                                                    </Border>
                                                </Grid>
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{ThemeResource SfTextMutedBrush}"
                                                    Text="{x:Bind Description}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap"
                                                    Visibility="{x:Bind DescriptionVisibility}" />
                                                <ProgressBar
                                                    Style="{StaticResource SfUsageBarStyle}"
                                                    Maximum="100"
                                                    Minimum="0"
                                                    Value="{x:Bind UsedPercent}"
                                                    Visibility="{x:Bind UsageVisibility}" />
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{ThemeResource SfTextMutedBrush}"
                                                    Text="{x:Bind UsageText}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap"
                                                    Visibility="{x:Bind UsageVisibility}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>

                        <StackPanel x:Name="FolderTreeSection" Spacing="2">
                            <Grid Margin="4,0,0,4">
                                <TextBlock Style="{StaticResource SfSidebarHeaderStyle}" Text="Folders" />
                                <Button
                                    Style="{StaticResource SfSidebarIconButtonStyle}"
                                    AutomationProperties.Name="Refresh folder tree"
                                    Click="OnRefreshFolderTree"
                                    ToolTipService.ToolTip="Refresh folder tree">
                                    <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="11" Glyph="&#xE72C;" />
                                </Button>
                            </Grid>
                            <TextBlock
                                x:Name="FolderTreeEmptyText"
                                Style="{StaticResource SfEmptyHintStyle}"
                                Text="No folders yet" />
                            <ListView
                                x:Name="FolderTreeList"
                                Style="{StaticResource SfSidebarListStyle}"
                                IsItemClickEnabled="True"
                                ItemClick="OnFolderTreeClick"
                                SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style BasedOn="{StaticResource SfNavListItemStyle}" TargetType="ListViewItem">
                                        <Setter Property="MinHeight" Value="28" />
                                        <Setter Property="Padding" Value="2,1" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Padding="0,1" Spacing="4">
                                            <Button
                                                Style="{StaticResource SfSidebarIconButtonStyle}"
                                                Width="20"
                                                Height="20"
                                                MinWidth="20"
                                                MinHeight="20"
                                                HorizontalAlignment="Center"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="OnFolderTreeToggle"
                                                Tag="{Binding Path}">
                                                <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="8" Glyph="&#xE76C;" />
                                            </Button>
                                            <local:ShellIconImage
                                                Width="16"
                                                Height="16"
                                                VerticalAlignment="Center"
                                                Path="{Binding Path=Path}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource SfTextPrimaryBrush}"
                                                Text="{Binding Name}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>

                        <StackPanel x:Name="BookmarksSection" Spacing="2">
                            <Grid Margin="4,0,0,4">
                                <TextBlock Style="{StaticResource SfSidebarHeaderStyle}" Text="Bookmarks" />
                                <Button
                                    Style="{StaticResource SfSidebarIconButtonStyle}"
                                    AutomationProperties.Name="Bookmark current folder"
                                    Click="OnAddBookmark"
                                    ToolTipService.ToolTip="Bookmark current folder">
                                    <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="12" Glyph="&#xE710;" />
                                </Button>
                            </Grid>
                            <TextBlock
                                x:Name="BookmarksEmptyText"
                                Style="{StaticResource SfEmptyHintStyle}"
                                Text="No bookmarks yet" />
                            <ListView
                                x:Name="BookmarksList"
                                Style="{StaticResource SfSidebarListStyle}"
                                IsItemClickEnabled="True"
                                ItemClick="OnBookmarkClick"
                                SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style BasedOn="{StaticResource SfNavListItemStyle}" TargetType="ListViewItem" />
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="2,1" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <local:ShellIconImage
                                                Width="16"
                                                Height="16"
                                                VerticalAlignment="Center"
                                                Path="{Binding Path=Path}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource SfTextPrimaryBrush}"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <Button
                                                Grid.Column="2"
                                                Style="{StaticResource SfSidebarIconButtonStyle}"
                                                Width="22"
                                                Height="22"
                                                MinWidth="22"
                                                MinHeight="22"
                                                Click="OnRemoveBookmark"
                                                Tag="{Binding Path}"
                                                ToolTipService.ToolTip="Remove bookmark">
                                                <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="10" Glyph="&#xE711;" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>

                        <StackPanel x:Name="RecentSection" Spacing="2">
                            <Grid Margin="4,0,0,4">
                                <TextBlock Style="{StaticResource SfSidebarHeaderStyle}" Text="Recent" />
                                <Button
                                    x:Name="ClearRecentsButton"
                                    Style="{StaticResource SfSidebarIconButtonStyle}"
                                    AutomationProperties.Name="Clear recent history"
                                    Click="OnClearRecentHistory"
                                    ToolTipService.ToolTip="Clear recent history">
                                    <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="10" Glyph="&#xE74D;" />
                                </Button>
                            </Grid>
                            <TextBlock
                                x:Name="RecentsEmptyText"
                                Style="{StaticResource SfEmptyHintStyle}"
                                Text="No recent folders" />
                            <ListView
                                x:Name="RecentsList"
                                Style="{StaticResource SfSidebarListStyle}"
                                IsItemClickEnabled="True"
                                ItemClick="OnRecentClick"
                                SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style BasedOn="{StaticResource SfNavListItemStyle}" TargetType="ListViewItem" />
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Padding="2,1" Spacing="10">
                                            <FontIcon
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource SfIconFont}"
                                                FontSize="12"
                                                Foreground="{ThemeResource SfTextMutedBrush}"
                                                Glyph="&#xE81C;" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource SfTextPrimaryBrush}"
                                                Text="{Binding}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>

                        <StackPanel x:Name="SmartFoldersSection" Spacing="2">
                            <Grid Margin="4,0,0,4">
                                <TextBlock Style="{StaticResource SfSidebarHeaderStyle}" Text="Smart folders" />
                                <Button
                                    Style="{StaticResource SfSidebarIconButtonStyle}"
                                    AutomationProperties.Name="Save current search as smart folder"
                                    Click="OnSaveSmartFolder"
                                    ToolTipService.ToolTip="Save current search">
                                    <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="12" Glyph="&#xE710;" />
                                </Button>
                            </Grid>
                            <TextBlock
                                x:Name="SmartFoldersEmptyText"
                                Style="{StaticResource SfEmptyHintStyle}"
                                Text="No smart folders yet" />
                            <ListView
                                x:Name="SmartFoldersList"
                                Style="{StaticResource SfSidebarListStyle}"
                                IsItemClickEnabled="True"
                                ItemClick="OnSmartFolderClicked"
                                SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style BasedOn="{StaticResource SfNavListItemStyle}" TargetType="ListViewItem" />
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="2,1" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource SfIconFont}"
                                                FontSize="13"
                                                Foreground="{ThemeResource SfTextMutedBrush}"
                                                Glyph="&#xE721;" />
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource SfTextPrimaryBrush}"
                                                Text="{Binding Name}" />
                                            <Button
                                                Grid.Column="2"
                                                Style="{StaticResource SfSidebarIconButtonStyle}"
                                                Width="22"
                                                Height="22"
                                                MinWidth="22"
                                                MinHeight="22"
                                                AutomationProperties.Name="Delete smart folder"
                                                Click="OnDeleteSmartFolderClicked"
                                                Tag="{Binding Id}">
                                                <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="10" Glyph="&#xE711;" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <local:PaneResizeGrip
                x:Name="SidebarDivider"
                Grid.Column="1"
                AutomationProperties.Name="Resize sidebar"
                DoubleTapped="OnSidebarDividerDoubleTapped"
                PointerMoved="OnSidebarDividerMoved"
                PointerPressed="OnSidebarDividerPressed"
                PointerReleased="OnSidebarDividerReleased">
                <Rectangle
                    Width="1"
                    HorizontalAlignment="Center"
                    Fill="{ThemeResource SfBorderBrush}" />
            </local:PaneResizeGrip>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <InfoBar
                    x:Name="MessageBar"
                    Margin="10,8,10,0"
                    IsClosable="True"
                    IsOpen="False"
                    Severity="Informational" />

                <Grid x:Name="ExplorerContentGrid" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="240" />
                        <ColumnDefinition x:Name="PreviewDividerColumn" Width="8" />
                        <ColumnDefinition x:Name="PreviewColumn" Width="296" MinWidth="200" MaxWidth="720" />
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="FilePaneShell" Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid
                            x:Name="PrimaryToolbar"
                            Grid.Row="0"
                            Padding="10,6,10,8"
                            ColumnSpacing="8"
                            SizeChanged="OnPrimaryToolbarSizeChanged">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="PrimarySearchColumn" Width="Auto" />
                                <ColumnDefinition x:Name="PrimaryActionsColumn" Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="PrimaryNavHost" Orientation="Horizontal" Spacing="2">
                                <Button
                                    x:Name="PrimarySidebarToggleButton"
                                    Style="{StaticResource SfToolbarButtonStyle}"
                                    AutomationProperties.Name="Toggle side menu"
                                    Click="OnToggleSidebar"
                                    ToolTipService.ToolTip="Hide side menu">
                                    <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="14" Glyph="&#xE700;" />
                                </Button>
                                <Button
                                    x:Name="PrimaryBackButton"
                                    Style="{StaticResource SfToolbarButtonStyle}"
                                    AutomationProperties.Name="Go back"
                                    Click="OnPrimaryBack"
                                    ToolTipService.ToolTip="Back">
                                    <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="14" Glyph="&#xE72B;" />
                                </Button>
                                <Button
                                    x:Name="PrimaryForwardButton"
                                    Style="{StaticResource SfToolbarButtonStyle}"
                                    AutomationProperties.Name="Go forward"
                                    Click="OnPrimaryForward"
                                    ToolTipService.ToolTip="Forward">
                                    <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="14" Glyph="&#xE72A;" />
                                </Button>
                                <Button
                                    x:Name="PrimaryUpButton"
                                    Style="{StaticResource SfToolbarButtonStyle}"
                                    AutomationProperties.Name="Go up"
                                    Click="OnPrimaryUp"
                                    ToolTipService.ToolTip="Up">
                                    <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="14" Glyph="&#xE74A;" />
                                </Button>
                            </StackPanel>
                            <Grid
                                x:Name="PrimarySearchHost"
                                Grid.Column="2"
                                Width="260"
                                MinWidth="260"
                                MaxWidth="480">
                                <TextBox
                                    x:Name="SearchBox"
                                    Padding="30,4,56,4"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Search active pane"
                                    CornerRadius="4"
                                    KeyDown="OnSearchKeyDown"
                                    PlaceholderText="Search" />
                                <Button
                                    Width="28"
                                    Height="28"
                                    Margin="2,0,0,0"
                                    Padding="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Search active pane"
                                    Click="OnSearchClick"
                                    Style="{StaticResource SfIconButtonStyle}"
                                    ToolTipService.ToolTip="Search active pane">
                                    <FontIcon
                                        FontFamily="{StaticResource SfIconFont}"
                                        FontSize="12"
                                        Glyph="&#xE721;" />
                                </Button>
                                <StackPanel
                                    Margin="0,0,2,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <ToggleButton
                                        x:Name="ContentSearchButton"
                                        Width="28"
                                        Height="28"
                                        MinWidth="28"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        AutomationProperties.Name="Search file contents"
                                        Click="OnContentSearchToggle"
                                        ToolTipService.ToolTip="Search file contents">
                                        <FontIcon
                                            FontFamily="{StaticResource SfIconFont}"
                                            FontSize="12"
                                            Glyph="&#xE8A5;" />
                                    </ToggleButton>
                                    <Button
                                        x:Name="SearchCancelButton"
                                        Width="28"
                                        Height="28"
                                        Padding="0"
                                        AutomationProperties.Name="Cancel search"
                                        Click="OnCancelSearchClick"
                                        IsEnabled="False"
                                        Style="{StaticResource SfIconButtonStyle}"
                                        ToolTipService.ToolTip="Cancel search">
                                        <FontIcon
                                            FontFamily="{StaticResource SfIconFont}"
                                            FontSize="11"
                                            Glyph="&#xE711;" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <StackPanel
                                x:Name="PrimaryActionsHost"
                                Grid.Column="3"
                                Orientation="Horizontal"
                                Spacing="2">
                                <TextBox
                                    x:Name="QuickFilterBox"
                                    Width="128"
                                    MinWidth="128"
                                    MaxWidth="200"
                                    Margin="4,0,6,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Quick filter active pane"
                                    Style="{StaticResource SfTextBoxStyle}"
                                    PlaceholderText="Filter"
                                    TextChanged="OnQuickFilterChanged" />
                                <Button
                                    x:Name="PrimaryNewFolderButton"
                                    Style="{StaticResource SfToolbarButtonStyle}"
                                    AutomationProperties.Name="New folder"
                                    Click="OnPrimaryNewFolder"
                                    ToolTipService.ToolTip="New Folder (Ctrl+Shift+N)">
                                    <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="14" Glyph="&#xE8F4;" />
                                </Button>
                                <Button
                                    x:Name="PrimaryNewFileButton"
                                    Style="{StaticResource SfToolbarButtonStyle}"
                                    AutomationProperties.Name="New file"
                                    Click="OnPrimaryNewFile"
                                    ToolTipService.ToolTip="New File (Ctrl+N)">
                                    <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="14" Glyph="&#xE8A5;" />
                                </Button>
                                <Button
                                    x:Name="DualPaneButton"
                                    Style="{StaticResource SfToolbarButtonStyle}"
                                    AutomationProperties.Name="Open second pane"
                                    Click="OnToggleDualPane"
                                    ToolTipService.ToolTip="Open second pane (F6)">
                                    <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="14" Glyph="&#xE8A0;" />
                                </Button>
                                <Button
                                    x:Name="ClosePrimaryPaneButton"
                                    Style="{StaticResource SfToolbarButtonStyle}"
                                    AutomationProperties.Name="Close left pane"
                                    Click="OnClosePrimaryPane"
                                    ToolTipService.ToolTip="Close left pane"
                                    Visibility="Collapsed">
                                    <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="12" Glyph="&#xE89F;" />
                                </Button>
                                <Button
                                    x:Name="PrimaryViewButton"
                                    Style="{StaticResource SfToolbarButtonStyle}"
                                    AutomationProperties.Name="View options"
                                    ToolTipService.ToolTip="View options">
                                    <Button.Flyout>
                                        <Flyout Opening="OnViewOptionsFlyoutOpening">
                                            <StackPanel
                                                MinWidth="280"
                                                Padding="4"
                                                Spacing="12">
                                                <Button
                                                    x:Name="ViewDualPaneButton"
                                                    Style="{StaticResource SfGhostButtonStyle}"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Click="OnViewDualPaneClicked">
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <FontIcon
                                                            x:Name="ViewDualPaneIcon"
                                                            FontFamily="{StaticResource SfIconFont}"
                                                            FontSize="14" />
                                                        <TextBlock x:Name="ViewDualPaneText" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <RadioButtons
                                                    x:Name="ViewStyleRadioButtons"
                                                    Header="Display style"
                                                    MaxColumns="2"
                                                    SelectionChanged="OnViewStyleSelectionChanged">
                                                    <RadioButton Content="Details" Tag="details" />
                                                    <RadioButton Content="List" Tag="list" />
                                                    <RadioButton Content="Tiles" Tag="tiles" />
                                                    <RadioButton Content="Content" Tag="content" />
                                                </RadioButtons>
                                                <StackPanel Spacing="6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Icon size" />
                                                        <TextBlock
                                                            x:Name="ViewIconSizeValueText"
                                                            Grid.Column="1"
                                                            Foreground="{ThemeResource SfTextMutedBrush}" />
                                                    </Grid>
                                                    <Slider
                                                        x:Name="ViewIconSizeSlider"
                                                        HorizontalAlignment="Stretch"
                                                        LargeChange="16"
                                                        Maximum="256"
                                                        Minimum="16"
                                                        SmallChange="8"
                                                        StepFrequency="8"
                                                        ValueChanged="OnViewIconSizeSliderChanged" />
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            FontSize="11"
                                                            Foreground="{ThemeResource SfTextMutedBrush}"
                                                            Text="16 px" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            FontSize="11"
                                                            Foreground="{ThemeResource SfTextMutedBrush}"
                                                            Text="256 px" />
                                                    </Grid>
                                                </StackPanel>
                                                <Button
                                                    x:Name="ViewApplyBothButton"
                                                    Style="{StaticResource SfGhostButtonStyle}"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Click="OnViewApplyBothClicked"
                                                    Content="Apply view options to both panes" />
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                    <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="14" Glyph="&#xE8A9;" />
                                </Button>
                                <Button
                                    x:Name="PrimarySettingsButton"
                                    Style="{StaticResource SfToolbarButtonStyle}"
                                    AutomationProperties.Name="Settings"
                                    Click="OnSettingsClicked"
                                    ToolTipService.ToolTip="Settings (Ctrl+Shift+S)">
                                    <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="14" Glyph="&#xE713;" />
                                </Button>
                            </StackPanel>
                            <Button
                                x:Name="PrimaryMoreButton"
                                Grid.Column="4"
                                Style="{StaticResource SfToolbarButtonStyle}"
                                AutomationProperties.Name="More"
                                ToolTipService.ToolTip="More">
                                <Button.Flyout>
                                    <MenuFlyout Opening="OnPrimaryMoreMenuOpening" />
                                </Button.Flyout>
                                <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="14" Glyph="&#xE712;" />
                            </Button>
                        </Grid>

                        <Grid x:Name="PanesGrid" Grid.Row="1" SizeChanged="OnPanesGridSizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="PrimaryColumn" Width="*" />
                            <ColumnDefinition x:Name="DividerColumn" Width="0" />
                            <ColumnDefinition x:Name="SecondaryColumn" Width="0" />
                        </Grid.ColumnDefinitions>

                        <Grid
                            x:Name="PrimaryPaneRoot"
                            Grid.Column="0"
                            Background="{ThemeResource SfBgPrimaryBrush}"
                            BorderBrush="{ThemeResource SfBorderBrush}"
                            BorderThickness="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border
                                x:Name="PrimaryActivePaneRail"
                                Grid.RowSpan="3"
                                Width="3"
                                HorizontalAlignment="Left"
                                Background="{ThemeResource SfAccentBrush}"
                                IsHitTestVisible="False"
                                Visibility="Collapsed" />
                            <Grid
                                x:Name="PrimaryPaneHeader"
                                Padding="10,6,10,0"
                                Background="{ThemeResource SfBgSecondaryBrush}"
                                BorderBrush="{ThemeResource SfBorderBrush}"
                                BorderThickness="0,0,0,1"
                                ColumnSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid
                                    Grid.Row="0"
                                    ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel
                                        x:Name="PrimaryPaneCaption"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="5"
                                        Visibility="Collapsed">
                                        <Rectangle
                                            x:Name="PrimaryPaneCaptionRail"
                                            Width="3"
                                            Height="14"
                                            Fill="{ThemeResource SfAccentBrush}"
                                            RadiusX="1"
                                            RadiusY="1" />
                                        <TextBlock
                                            x:Name="PrimaryPaneCaptionText"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource SfTextMutedBrush}"
                                            Text="Left" />
                                    </StackPanel>
                                    <ScrollViewer
                                        Grid.Column="1"
                                        HorizontalScrollBarVisibility="Auto"
                                        VerticalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="PrimaryTabHost" Orientation="Horizontal" Spacing="2" />
                                    </ScrollViewer>
                                </Grid>
                                <Grid
                                    Grid.Row="1"
                                    Margin="0,6,0,6"
                                    ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid
                                        x:Name="PrimaryPathBar"
                                        Grid.Column="0"
                                        MinHeight="34"
                                        Padding="6,2"
                                        Background="{ThemeResource SfBgTertiaryBrush}"
                                        BorderBrush="{ThemeResource SfBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                        <ScrollViewer
                                            x:Name="PrimaryBreadcrumbScroller"
                                            VerticalAlignment="Center"
                                            HorizontalScrollBarVisibility="Auto"
                                            VerticalScrollBarVisibility="Disabled">
                                            <StackPanel x:Name="PrimaryBreadcrumbHost" VerticalAlignment="Center" Orientation="Horizontal" />
                                        </ScrollViewer>
                                        <TextBox
                                            x:Name="PrimaryPathInput"
                                            Style="{StaticResource SfTextBoxStyle}"
                                            BorderThickness="0"
                                            PlaceholderText="Enter path..."
                                            Visibility="Collapsed"
                                            KeyDown="OnPrimaryPathKeyDown"
                                            LostFocus="OnPrimaryPathLostFocus"
                                            TextChanged="OnPrimaryPathTextChanged" />
                                    </Grid>
                                    <Button
                                        x:Name="PrimaryEditPathButton"
                                        Grid.Column="1"
                                        Style="{StaticResource SfToolbarButtonStyle}"
                                        Click="OnEditPrimaryPath"
                                        ToolTipService.ToolTip="Edit path">
                                        <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="13" Glyph="&#xE70F;" />
                                    </Button>
                                </Grid>
                            </Grid>
                            <ScrollViewer
                                x:Name="PrimaryColumnHeaderScroller"
                                Grid.Row="1"
                                HorizontalScrollBarVisibility="Hidden"
                                HorizontalScrollMode="Disabled"
                                VerticalScrollBarVisibility="Disabled"
                                VerticalScrollMode="Disabled">
                                <Grid
                                    x:Name="PrimaryColumnHeader"
                                    Padding="10,0,0,0"
                                    HorizontalAlignment="Left"
                                    Background="Transparent"
                                    BorderBrush="{ThemeResource SfBorderBrush}"
                                    BorderThickness="0,0,0,1" />
                            </ScrollViewer>
                            <Grid
                                Grid.Row="2"
                                Background="Transparent"
                                PointerPressed="OnPrimaryMarqueePressed"
                                PointerMoved="OnMarqueePointerMoved"
                                PointerReleased="OnMarqueePointerReleased"
                                PointerCanceled="OnMarqueePointerCanceled">
                                <ListView
                                    x:Name="PrimaryFileList"
                                    Padding="2,4,2,6"
                                    AllowDrop="True"
                                    CanDragItems="True"
                                    AutomationProperties.Name="Left pane files"
                                    DoubleTapped="OnPrimaryFileDoubleTapped"
                                    DragItemsStarting="OnFileDragItemsStarting"
                                    DragItemsCompleted="OnFileDragItemsCompleted"
                                    DragLeave="OnFileDragLeave"
                                    DragOver="OnPrimaryFileDragOver"
                                    Drop="OnPrimaryFileDrop"
                                    IsItemClickEnabled="False"
                                    IsMultiSelectCheckBoxEnabled="False"
                                    KeyDown="OnPrimaryFileKeyDown"
                                    RightTapped="OnPrimaryFileRightTapped"
                                    SelectionChanged="OnPrimarySelectionChanged"
                                    SelectionMode="Extended"
                                    SingleSelectionFollowsFocus="False">
                                    <ListView.ItemContainerStyle>
                                        <Style BasedOn="{StaticResource SfFileListItemStyle}" TargetType="ListViewItem" />
                                    </ListView.ItemContainerStyle>
                                    <ListView.ContextFlyout>
                                        <MenuFlyout Opening="OnPrimaryFileListContextOpening" />
                                    </ListView.ContextFlyout>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:FileRow">
                                            <local:FileRowView Row="{x:Bind}" ContextRequested="OnFileRowContextRequested" />
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <Canvas x:Name="PrimaryMarqueeCanvas" IsHitTestVisible="False">
                                    <Rectangle
                                        x:Name="PrimaryMarqueeRect"
                                        Visibility="Collapsed"
                                        Stroke="{ThemeResource SfAccentBrush}"
                                        StrokeThickness="1"
                                        Fill="{ThemeResource SfAccentSoftBrush}"
                                        RadiusX="2"
                                        RadiusY="2" />
                                </Canvas>
                                <StackPanel
                                    x:Name="PrimaryEmptyState"
                                    MaxWidth="360"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False"
                                    Spacing="6"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        x:Name="PrimaryEmptyTitle"
                                        HorizontalAlignment="Center"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource SfTextPrimaryBrush}"
                                        Text="This folder is empty"
                                        TextAlignment="Center" />
                                    <TextBlock
                                        x:Name="PrimaryEmptyHint"
                                        HorizontalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource SfTextMutedBrush}"
                                        Text="Drop files here, or press Ctrl+Shift+N to create a folder"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <local:PaneResizeGrip
                            x:Name="PaneDivider"
                            Grid.Column="1"
                            AutomationProperties.Name="Resize left and right panes"
                            DoubleTapped="OnDividerDoubleTapped"
                            PointerMoved="OnDividerMoved"
                            PointerPressed="OnDividerPressed"
                            PointerReleased="OnDividerReleased"
                            Visibility="Collapsed">
                            <Rectangle
                                Width="1"
                                HorizontalAlignment="Center"
                                Fill="{ThemeResource SfBorderBrush}" />
                        </local:PaneResizeGrip>

                        <Grid
                            x:Name="SecondaryPaneRoot"
                            Grid.Column="2"
                            Background="{ThemeResource SfBgPrimaryBrush}"
                            BorderBrush="{ThemeResource SfBorderBrush}"
                            BorderThickness="0"
                            Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border
                                x:Name="SecondaryActivePaneRail"
                                Grid.RowSpan="3"
                                Width="3"
                                HorizontalAlignment="Left"
                                Background="{ThemeResource SfAccentBrush}"
                                IsHitTestVisible="False"
                                Visibility="Collapsed" />
                            <Grid
                                x:Name="SecondaryPaneHeader"
                                Padding="10,6,10,0"
                                Background="{ThemeResource SfBgSecondaryBrush}"
                                BorderBrush="{ThemeResource SfBorderBrush}"
                                BorderThickness="0,0,0,1"
                                ColumnSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid
                                    Grid.Row="0"
                                    ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel
                                        x:Name="SecondaryPaneCaption"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="5"
                                        Visibility="Collapsed">
                                        <Rectangle
                                            x:Name="SecondaryPaneCaptionRail"
                                            Width="3"
                                            Height="14"
                                            Fill="{ThemeResource SfAccentBrush}"
                                            RadiusX="1"
                                            RadiusY="1" />
                                        <TextBlock
                                            x:Name="SecondaryPaneCaptionText"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource SfTextMutedBrush}"
                                            Text="Right" />
                                    </StackPanel>
                                    <ScrollViewer
                                        Grid.Column="1"
                                        HorizontalScrollBarVisibility="Auto"
                                        VerticalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="SecondaryTabHost" Orientation="Horizontal" Spacing="2" />
                                    </ScrollViewer>
                                </Grid>
                                <Grid
                                    Grid.Row="1"
                                    Margin="0,6,0,6"
                                    ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid
                                        x:Name="SecondaryPathBar"
                                        Grid.Column="0"
                                        MinHeight="34"
                                        Padding="6,2"
                                        Background="{ThemeResource SfBgTertiaryBrush}"
                                        BorderBrush="{ThemeResource SfBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                        <ScrollViewer
                                            x:Name="SecondaryBreadcrumbScroller"
                                            VerticalAlignment="Center"
                                            HorizontalScrollBarVisibility="Auto"
                                            VerticalScrollBarVisibility="Disabled">
                                            <StackPanel x:Name="SecondaryBreadcrumbHost" VerticalAlignment="Center" Orientation="Horizontal" />
                                        </ScrollViewer>
                                        <TextBox
                                            x:Name="SecondaryPathInput"
                                            Style="{StaticResource SfTextBoxStyle}"
                                            BorderThickness="0"
                                            PlaceholderText="Enter path..."
                                            Visibility="Collapsed"
                                            KeyDown="OnSecondaryPathKeyDown"
                                            LostFocus="OnSecondaryPathLostFocus"
                                            TextChanged="OnSecondaryPathTextChanged" />
                                    </Grid>
                                    <Button
                                        x:Name="SecondaryEditPathButton"
                                        Grid.Column="1"
                                        Style="{StaticResource SfToolbarButtonStyle}"
                                        Click="OnEditSecondaryPath"
                                        ToolTipService.ToolTip="Edit path">
                                        <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="13" Glyph="&#xE70F;" />
                                    </Button>
                                </Grid>
                            </Grid>
                            <ScrollViewer
                                x:Name="SecondaryColumnHeaderScroller"
                                Grid.Row="1"
                                HorizontalScrollBarVisibility="Hidden"
                                HorizontalScrollMode="Disabled"
                                VerticalScrollBarVisibility="Disabled"
                                VerticalScrollMode="Disabled">
                                <Grid
                                    x:Name="SecondaryColumnHeader"
                                    Padding="10,0,0,0"
                                    HorizontalAlignment="Left"
                                    Background="Transparent"
                                    BorderBrush="{ThemeResource SfBorderBrush}"
                                    BorderThickness="0,0,0,1" />
                            </ScrollViewer>
                            <Grid
                                Grid.Row="2"
                                Background="Transparent"
                                PointerPressed="OnSecondaryMarqueePressed"
                                PointerMoved="OnMarqueePointerMoved"
                                PointerReleased="OnMarqueePointerReleased"
                                PointerCanceled="OnMarqueePointerCanceled">
                                <ListView
                                    x:Name="SecondaryFileList"
                                    Padding="2,4,2,6"
                                    AllowDrop="True"
                                    CanDragItems="True"
                                    AutomationProperties.Name="Right pane files"
                                    DoubleTapped="OnSecondaryFileDoubleTapped"
                                    DragItemsStarting="OnFileDragItemsStarting"
                                    DragItemsCompleted="OnFileDragItemsCompleted"
                                    DragLeave="OnFileDragLeave"
                                    DragOver="OnSecondaryFileDragOver"
                                    Drop="OnSecondaryFileDrop"
                                    IsItemClickEnabled="False"
                                    IsMultiSelectCheckBoxEnabled="False"
                                    KeyDown="OnSecondaryFileKeyDown"
                                    RightTapped="OnSecondaryFileRightTapped"
                                    SelectionChanged="OnSecondarySelectionChanged"
                                    SelectionMode="Extended"
                                    SingleSelectionFollowsFocus="False">
                                    <ListView.ItemContainerStyle>
                                        <Style BasedOn="{StaticResource SfFileListItemStyle}" TargetType="ListViewItem" />
                                    </ListView.ItemContainerStyle>
                                    <ListView.ContextFlyout>
                                        <MenuFlyout Opening="OnSecondaryFileListContextOpening" />
                                    </ListView.ContextFlyout>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:FileRow">
                                            <local:FileRowView Row="{x:Bind}" ContextRequested="OnFileRowContextRequested" />
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <Canvas x:Name="SecondaryMarqueeCanvas" IsHitTestVisible="False">
                                    <Rectangle
                                        x:Name="SecondaryMarqueeRect"
                                        Visibility="Collapsed"
                                        Stroke="{ThemeResource SfAccentBrush}"
                                        StrokeThickness="1"
                                        Fill="{ThemeResource SfAccentSoftBrush}"
                                        RadiusX="2"
                                        RadiusY="2" />
                                </Canvas>
                                <StackPanel
                                    x:Name="SecondaryEmptyState"
                                    MaxWidth="360"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False"
                                    Spacing="6"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        x:Name="SecondaryEmptyTitle"
                                        HorizontalAlignment="Center"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource SfTextPrimaryBrush}"
                                        Text="This folder is empty"
                                        TextAlignment="Center" />
                                    <TextBlock
                                        x:Name="SecondaryEmptyHint"
                                        HorizontalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource SfTextMutedBrush}"
                                        Text="Drop files here, or press Ctrl+Shift+N to create a folder"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                    </Grid>

                    <local:PaneResizeGrip
                        x:Name="PreviewDivider"
                        Grid.Column="1"
                        AutomationProperties.Name="Resize preview pane"
                        DoubleTapped="OnPreviewDividerDoubleTapped"
                        PointerMoved="OnPreviewDividerMoved"
                        PointerPressed="OnPreviewDividerPressed"
                        PointerReleased="OnPreviewDividerReleased">
                        <Rectangle
                            Width="1"
                            HorizontalAlignment="Center"
                            Fill="{ThemeResource SfBorderBrush}" />
                    </local:PaneResizeGrip>

                    <Border
                        x:Name="PreviewPane"
                        Grid.Column="2"
                        Padding="14"
                        Background="{ThemeResource SfBgSecondaryBrush}"
                        BorderBrush="{ThemeResource SfBorderBrush}"
                        BorderThickness="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="PreviewTitle"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource SfTextPrimaryBrush}"
                                        Text="Preview"
                                        TextTrimming="CharacterEllipsis" />
                                    <Button
                                        Grid.Column="1"
                                        Style="{StaticResource SfSidebarIconButtonStyle}"
                                        AutomationProperties.Name="Hide preview pane"
                                        Click="OnTogglePreview"
                                        ToolTipService.ToolTip="Hide preview pane">
                                        <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="11" Glyph="&#xE711;" />
                                    </Button>
                                </Grid>
                                <TextBlock
                                    x:Name="PreviewSubtitle"
                                    FontSize="12"
                                    Foreground="{ThemeResource SfTextMutedBrush}"
                                    Text="Select a file"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Button
                                        x:Name="PreviewOpenButton"
                                        Style="{StaticResource SfToolbarButtonStyle}"
                                        AutomationProperties.Name="Open preview selection"
                                        Click="OnPreviewOpenClick"
                                        IsEnabled="False"
                                        ToolTipService.ToolTip="Open">
                                        <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="14" Glyph="&#xE8E5;" />
                                    </Button>
                                    <Button
                                        x:Name="PreviewOpenWithButton"
                                        Style="{StaticResource SfToolbarButtonStyle}"
                                        AutomationProperties.Name="Open with"
                                        Click="OnPreviewOpenWithClick"
                                        IsEnabled="False"
                                        ToolTipService.ToolTip="Open with">
                                        <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="14" Glyph="&#xE7AC;" />
                                    </Button>
                                    <Button
                                        x:Name="PreviewRevealButton"
                                        Style="{StaticResource SfToolbarButtonStyle}"
                                        AutomationProperties.Name="Reveal in folder"
                                        Click="OnPreviewRevealClick"
                                        IsEnabled="False"
                                        ToolTipService.ToolTip="Reveal in folder">
                                        <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="14" Glyph="&#xE8DA;" />
                                    </Button>
                                    <Button
                                        x:Name="PreviewCompareButton"
                                        Style="{StaticResource SfToolbarButtonStyle}"
                                        AutomationProperties.Name="Compare selected files"
                                        Click="OnPreviewCompareClick"
                                        IsEnabled="False"
                                        ToolTipService.ToolTip="Compare selected files">
                                        <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="14" Glyph="&#xE8AB;" />
                                    </Button>
                                    <Button
                                        x:Name="PreviewChecksumButton"
                                        Style="{StaticResource SfToolbarButtonStyle}"
                                        AutomationProperties.Name="Compute checksums"
                                        Click="OnPreviewChecksumClick"
                                        IsEnabled="False"
                                        ToolTipService.ToolTip="Checksums">
                                        <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="14" Glyph="&#xE9D9;" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="10">
                                    <StackPanel
                                        x:Name="PreviewIconPanel"
                                        HorizontalAlignment="Center"
                                        Spacing="6"
                                        Visibility="Collapsed">
                                        <Image
                                            x:Name="PreviewIconImage"
                                            Width="96"
                                            Height="96"
                                            Stretch="Uniform" />
                                        <TextBlock
                                            x:Name="PreviewIconLabel"
                                            HorizontalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{ThemeResource SfTextMutedBrush}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                    </StackPanel>
                                    <Image
                                        x:Name="PreviewImage"
                                        MaxHeight="220"
                                        Stretch="Uniform"
                                        Visibility="Collapsed" />
                                    <TextBox
                                        x:Name="PreviewTextBox"
                                        MaxHeight="280"
                                        AcceptsReturn="True"
                                        FontFamily="Consolas"
                                        FontSize="12"
                                        IsReadOnly="True"
                                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                                        TextWrapping="NoWrap"
                                        Visibility="Collapsed" />
                                    <TextBlock
                                        x:Name="PreviewEmptyText"
                                        Foreground="{ThemeResource SfTextMutedBrush}"
                                        Text="No preview loaded."
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource SfTextPrimaryBrush}"
                                        Text="Metadata" />
                                    <StackPanel x:Name="PreviewMetadataRows" Spacing="5" />
                                    <TextBlock
                                        x:Name="PreviewChecksumText"
                                        FontFamily="Consolas"
                                        FontSize="11"
                                        Foreground="{ThemeResource SfTextMutedBrush}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <Grid
                    Grid.Row="2"
                    Padding="12,6"
                    Background="{ThemeResource SfBgSecondaryBrush}"
                    BorderBrush="{ThemeResource SfBorderBrush}"
                    BorderThickness="0,1,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="StatusText"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource SfTextMutedBrush}"
                        Text="Starting SumaFile service..."
                        TextTrimming="CharacterEllipsis" />
                    <Button
                        x:Name="PreviewToggleButton"
                        Grid.Column="1"
                        Style="{StaticResource SfGhostButtonStyle}"
                        MinHeight="26"
                        Margin="8,0"
                        Padding="8,3"
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="Toggle preview pane"
                        Click="OnTogglePreview"
                        ToolTipService.ToolTip="Toggle preview pane">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon
                                FontFamily="{StaticResource SfIconFont}"
                                FontSize="12"
                                Glyph="&#xE8FF;" />
                            <TextBlock FontSize="12" Text="Preview" />
                        </StackPanel>
                    </Button>
                    <TextBlock
                        x:Name="CountText"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource SfTextMutedBrush}" />
                </Grid>
            </Grid>
        </Grid>

        <Grid
            x:Name="CommandPaletteOverlay"
            Grid.RowSpan="2"
            Background="#99000000"
            Visibility="Collapsed"
            PointerPressed="OnCommandPaletteOverlayPressed">
            <Border
                Width="560"
                MaxHeight="420"
                Margin="0,72,0,0"
                Padding="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="{ThemeResource SfBgPrimaryBrush}"
                BorderBrush="{ThemeResource SfBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                PointerPressed="OnCommandPaletteInnerPressed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBox
                        x:Name="CommandPaletteInput"
                        Style="{StaticResource SfTextBoxStyle}"
                        AutomationProperties.Name="Command palette"
                        PlaceholderText="Type a command..."
                        TextChanged="OnCommandPaletteTextChanged"
                        KeyDown="OnCommandPaletteKeyDown" />
                    <ListView
                        x:Name="CommandPaletteList"
                        Grid.Row="1"
                        Margin="0,8,0,0"
                        AutomationProperties.Name="Commands"
                        IsItemClickEnabled="True"
                        ItemClick="OnCommandPaletteItemClick"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="core:AppCommand">
                                <Grid Padding="4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{ThemeResource SfTextPrimaryBrush}" Text="{x:Bind Label}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        FontSize="12"
                                        Foreground="{ThemeResource SfTextMutedBrush}"
                                        Text="{x:Bind Shortcut}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
