<Window
    x:Class="SimpleFile.App.TransferProgressWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Transfers">
    <Grid
        x:Name="Root"
        MinWidth="640"
        MinHeight="360"
        Padding="16"
        Background="{ThemeResource SfBgSecondaryBrush}"
        RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource SfTextPrimaryBrush}"
                    Text="Transfers" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource SfTextMutedBrush}"
                    Text="{Binding HeaderText}" />
            </StackPanel>
        </Grid>

        <ListView
            x:Name="TransferList"
            Grid.Row="1"
            BorderThickness="0"
            IsItemClickEnabled="False"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border
                        Padding="12"
                        Background="{ThemeResource SfBgPrimaryBrush}"
                        BorderBrush="{ThemeResource SfBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel MinWidth="0" Spacing="3">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource SfTextPrimaryBrush}"
                                        Text="{Binding Title}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource SfTextMutedBrush}"
                                        MaxLines="1"
                                        Text="{Binding RouteText}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="1"
                                    MinWidth="76"
                                    HorizontalAlignment="Right"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource SfTextPrimaryBrush}"
                                    Text="{Binding StatusLabel}" />
                            </Grid>

                            <Grid Grid.Row="1">
                                <ProgressBar
                                    Height="4"
                                    Minimum="0"
                                    Maximum="100"
                                    Background="{ThemeResource SfBorderBrush}"
                                    Foreground="{ThemeResource SfAccentBrush}"
                                    IsIndeterminate="{Binding IsIndeterminate}"
                                    Value="{Binding ProgressPercent}" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    Margin="0,-18,0,0"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource SfTextPrimaryBrush}"
                                    Text="{Binding PercentText}" />
                            </Grid>

                            <Grid Grid.Row="2" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel MinWidth="0" Spacing="3">
                                    <TextBlock
                                        FontSize="13"
                                        Foreground="{ThemeResource SfTextPrimaryBrush}"
                                        Text="{Binding CurrentItemText}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource SfTextMutedBrush}"
                                        Text="{Binding StatusDetailText}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    MinWidth="88"
                                    VerticalAlignment="Center"
                                    Click="OnCancelOperationClicked"
                                    IsEnabled="{Binding CanCancel}"
                                    Style="{StaticResource SfGhostButtonStyle}"
                                    Tag="{Binding}"
                                    ToolTipService.ToolTip="Cancel transfer">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon
                                            FontFamily="{StaticResource SfIconFont}"
                                            FontSize="11"
                                            Glyph="&#xE711;" />
                                        <TextBlock Text="Cancel" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                x:Name="ClearCompletedButton"
                Click="OnClearCompletedClicked"
                IsEnabled="{Binding HasTerminalOperations}"
                Style="{StaticResource SfGhostButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon
                        FontFamily="{StaticResource SfIconFont}"
                        FontSize="11"
                        Glyph="&#xE74D;" />
                    <TextBlock Text="Clear completed" />
                </StackPanel>
            </Button>
            <Button
                Click="OnCloseClicked"
                Style="{StaticResource SfGhostButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon
                        FontFamily="{StaticResource SfIconFont}"
                        FontSize="11"
                        Glyph="&#xE8BB;" />
                    <TextBlock Text="Close" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
