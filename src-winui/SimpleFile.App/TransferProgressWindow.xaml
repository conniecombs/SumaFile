<Window
    x:Class="SimpleFile.App.TransferProgressWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SimpleFile.App"
    Title="Transfers">
    <Grid
        x:Name="Root"
        MinWidth="640"
        MinHeight="360"
        Padding="16"
        Background="{ThemeResource SfBgSecondaryBrush}"
        RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource SfTextPrimaryBrush}"
                    Text="Transfers" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource SfTextMutedBrush}"
                    Text="{Binding HeaderText}" />
            </StackPanel>
        </Grid>

        <ListView
            x:Name="TransferList"
            Grid.Row="1"
            BorderThickness="0"
            IsItemClickEnabled="False"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border
                        Padding="12"
                        Background="{ThemeResource SfBgPrimaryBrush}"
                        BorderBrush="{ThemeResource SfBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel MinWidth="0" Spacing="3">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource SfTextPrimaryBrush}"
                                        Text="{Binding Title}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource SfTextMutedBrush}"
                                        MaxLines="1"
                                        Text="{Binding RouteText}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="1"
                                    MinWidth="76"
                                    HorizontalAlignment="Right"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource SfTextPrimaryBrush}"
                                    Text="{Binding StatusLabel}" />
                            </Grid>
                            <Expander
                                Grid.Row="3"
                                Header="Details"
                                IsExpanded="False"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding TuningText}" TextWrapping="Wrap" FontSize="12"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource SfTextMutedBrush}" />
                                    <Button Grid.Column="1" Content="Options" Click="OnTaskOptionsClicked" Tag="{Binding}"
                                            AutomationProperties.Name="Transfer options for this task"
                                            IsEnabled="{Binding CanChangeOptions}" Style="{StaticResource SfGhostButtonStyle}" />
                                </Grid>
                                <!-- The files being copied now, under the folder each comes from. Each line is one
                                     row high: a folder or a name too long for it is shortened by FittedText, and
                                     the progress column has a fixed width so the figures line up. -->
                                <ScrollViewer MaxHeight="280" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl Margin="0,0,14,0" ItemsSource="{Binding ActiveFolders}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,6">
                                                    <Grid Background="Transparent" RightTapped="OnActivePathRightTapped" Tag="{Binding Folder}">
                                                        <local:FittedText
                                                            FontSize="12"
                                                            FontWeight="SemiBold"
                                                            Foreground="{ThemeResource SfTextMutedBrush}"
                                                            Kind="FolderPath"
                                                            Text="{Binding Folder}"
                                                            ToolTipService.ToolTip="{Binding Folder}" />
                                                    </Grid>
                                                    <ItemsControl ItemsSource="{Binding Files}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="16,3,0,0" Background="Transparent" ColumnSpacing="12"
                                                                      RightTapped="OnActivePathRightTapped" Tag="{Binding Path}">
                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="160" /></Grid.ColumnDefinitions>
                                                                    <local:FittedText
                                                                        FontSize="12"
                                                                        Foreground="{ThemeResource SfTextPrimaryBrush}"
                                                                        Kind="FileName"
                                                                        Text="{Binding Name}"
                                                                        ToolTipService.ToolTip="{Binding Path}" />
                                                                    <TextBlock
                                                                        Grid.Column="1"
                                                                        HorizontalAlignment="Right"
                                                                        FontSize="12"
                                                                        Foreground="{ThemeResource SfTextMutedBrush}"
                                                                        Text="{Binding Progress}"
                                                                        TextTrimming="CharacterEllipsis" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                            </Expander>

                            <Grid Grid.Row="1">
                                <ProgressBar AutomationProperties.Name="Transfer progress"
                                    Height="4"
                                    Minimum="0"
                                    Maximum="100"
                                    Background="{ThemeResource SfBorderBrush}"
                                    Foreground="{ThemeResource SfAccentBrush}"
                                    IsIndeterminate="{Binding IsIndeterminate}"
                                    Value="{Binding ProgressPercent}" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    Margin="0,-18,0,0"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource SfTextPrimaryBrush}"
                                    Text="{Binding PercentText}" />
                            </Grid>

                            <Grid Grid.Row="2" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel MinWidth="0" Spacing="3">
                                    <!-- One file by name; with several at once, "name and 7 more files". A long
                                         name is shortened and the count stays whole. -->
                                    <local:FittedText
                                        FontSize="13"
                                        Foreground="{ThemeResource SfTextPrimaryBrush}"
                                        Kind="FileName"
                                        Suffix="{Binding CurrentItemSuffix}"
                                        Text="{Binding CurrentItemText}"
                                        ToolTipService.ToolTip="{Binding CurrentItemLine}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource SfTextMutedBrush}"
                                        Text="{Binding StatusDetailText}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    MinWidth="88"
                                    VerticalAlignment="Center"
                                    Click="OnCancelOperationClicked"
                                    IsEnabled="{Binding CanCancel}"
                                    Style="{StaticResource SfGhostButtonStyle}"
                                    Tag="{Binding}"
                                    ToolTipService.ToolTip="Cancel transfer">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon
                                            FontFamily="{StaticResource SfIconFont}"
                                            FontSize="11"
                                            Glyph="&#xE711;" />
                                        <TextBlock Text="Cancel" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button Content="Transfer defaults" Click="OnDefaultsClicked" Style="{StaticResource SfGhostButtonStyle}" />
            <Button
                x:Name="ClearCompletedButton"
                Click="OnClearCompletedClicked"
                IsEnabled="{Binding HasTerminalOperations}"
                Style="{StaticResource SfGhostButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon
                        FontFamily="{StaticResource SfIconFont}"
                        FontSize="11"
                        Glyph="&#xE74D;" />
                    <TextBlock Text="Clear completed" />
                </StackPanel>
            </Button>
            <Button
                Click="OnCloseClicked"
                Style="{StaticResource SfGhostButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon
                        FontFamily="{StaticResource SfIconFont}"
                        FontSize="11"
                        Glyph="&#xE8BB;" />
                    <TextBlock Text="Close" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
