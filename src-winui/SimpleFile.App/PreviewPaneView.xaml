<UserControl
    x:Class="SimpleFile.App.PreviewPaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SimpleFile.App"
    xmlns:core="using:SimpleFile.Core"
    xmlns:ipc="using:SimpleFile.Ipc">
                    <Border
                        x:Name="PreviewPane"
                        Grid.Column="2"
                        Padding="14"
                        Background="{ThemeResource SfBgSecondaryBrush}"
                        BorderBrush="{ThemeResource SfBorderBrush}"
                        BorderThickness="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="PreviewTitle"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource SfTextPrimaryBrush}"
                                        Text="Preview"
                                        TextTrimming="CharacterEllipsis" />
                                    <Button
                                        Grid.Column="1"
                                        Style="{StaticResource SfSidebarIconButtonStyle}"
                                        AutomationProperties.Name="Hide preview pane"
                                        Click="OnTogglePreview"
                                        ToolTipService.ToolTip="Hide preview pane">
                                        <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="11" Glyph="&#xE711;" />
                                    </Button>
                                </Grid>
                                <TextBlock
                                    x:Name="PreviewSubtitle"
                                    FontSize="12"
                                    Foreground="{ThemeResource SfTextMutedBrush}"
                                    Text="Select a file"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Button
                                        x:Name="PreviewOpenButton"
                                        Style="{StaticResource SfToolbarButtonStyle}"
                                        AutomationProperties.Name="Open preview selection"
                                        Click="OnPreviewOpenClick"
                                        IsEnabled="False"
                                        ToolTipService.ToolTip="Open">
                                        <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="14" Glyph="&#xE8E5;" />
                                    </Button>
                                    <Button
                                        x:Name="PreviewOpenWithButton"
                                        Style="{StaticResource SfToolbarButtonStyle}"
                                        AutomationProperties.Name="Open with"
                                        Click="OnPreviewOpenWithClick"
                                        IsEnabled="False"
                                        ToolTipService.ToolTip="Open with">
                                        <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="14" Glyph="&#xE7AC;" />
                                    </Button>
                                    <Button
                                        x:Name="PreviewRevealButton"
                                        Style="{StaticResource SfToolbarButtonStyle}"
                                        AutomationProperties.Name="Reveal in folder"
                                        Click="OnPreviewRevealClick"
                                        IsEnabled="False"
                                        ToolTipService.ToolTip="Reveal in folder">
                                        <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="14" Glyph="&#xE8DA;" />
                                    </Button>
                                    <Button
                                        x:Name="PreviewCompareButton"
                                        Style="{StaticResource SfToolbarButtonStyle}"
                                        AutomationProperties.Name="Compare selected files"
                                        Click="OnPreviewCompareClick"
                                        IsEnabled="False"
                                        ToolTipService.ToolTip="Compare selected files">
                                        <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="14" Glyph="&#xE8AB;" />
                                    </Button>
                                    <Button
                                        x:Name="PreviewChecksumButton"
                                        Style="{StaticResource SfToolbarButtonStyle}"
                                        AutomationProperties.Name="Compute checksums"
                                        Click="OnPreviewChecksumClick"
                                        IsEnabled="False"
                                        ToolTipService.ToolTip="Checksums">
                                        <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="14" Glyph="&#xE9D9;" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="10">
                                    <StackPanel
                                        x:Name="PreviewIconPanel"
                                        HorizontalAlignment="Center"
                                        Spacing="6"
                                        Visibility="Collapsed">
                                        <Image
                                            x:Name="PreviewIconImage"
                                            Width="96"
                                            Height="96"
                                            Stretch="Uniform" />
                                        <TextBlock
                                            x:Name="PreviewIconLabel"
                                            HorizontalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{ThemeResource SfTextMutedBrush}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                    </StackPanel>
                                    <Image
                                        x:Name="PreviewImage"
                                        MaxHeight="220"
                                        Stretch="Uniform"
                                        Visibility="Collapsed" />
                                    <TextBox
                                        x:Name="PreviewTextBox"
                                        MaxHeight="280"
                                        AcceptsReturn="True"
                                        FontFamily="Consolas"
                                        FontSize="12"
                                        IsReadOnly="True"
                                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                                        TextWrapping="NoWrap"
                                        Visibility="Collapsed" />
                                    <TextBlock
                                        x:Name="PreviewEmptyText"
                                        Foreground="{ThemeResource SfTextMutedBrush}"
                                        Text="No preview loaded."
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource SfTextPrimaryBrush}"
                                        Text="Metadata" />
                                    <StackPanel x:Name="PreviewMetadataRows" Spacing="5" />
                                    <TextBlock
                                        x:Name="PreviewChecksumText"
                                        FontFamily="Consolas"
                                        FontSize="11"
                                        Foreground="{ThemeResource SfTextMutedBrush}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
</UserControl>
