<ContentDialog
    x:Class="SimpleFile.App.ConflictDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="File Conflict"
    PrimaryButtonText="Replace"
    SecondaryButtonText="Skip"
    CloseButtonText="Cancel"
    DefaultButton="Close">
    <StackPanel Spacing="12">
        <TextBlock x:Name="OperationSummary" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="DestinationSummary" TextWrapping="Wrap" />
        <TextBlock x:Name="ConflictMessage" TextWrapping="Wrap" />
        <TextBlock x:Name="ChoiceHint" TextWrapping="Wrap" />
        <CheckBox x:Name="ApplyToAll" Content="Apply to all remaining conflicts" />
        <Button x:Name="KeepBothButton" Content="Keep both" HorizontalAlignment="Stretch" />
    </StackPanel>
</ContentDialog>
