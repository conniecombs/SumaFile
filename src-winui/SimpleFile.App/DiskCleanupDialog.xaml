<ContentDialog
    x:Class="SimpleFile.App.DiskCleanupDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Analyze Cleanup"
    PrimaryButtonText="Analyze"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick"
    CloseButtonClick="OnCloseButtonClick"
    Loaded="OnLoaded">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">680</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">440</x:Double>
    </ContentDialog.Resources>

    <Grid x:Name="DialogRoot" Width="440">
        <!-- Configuration -->
        <StackPanel x:Name="PhaseConfig" Spacing="16">
            <TextBlock
                Text="Scan the current folder for large files and duplicate groups. The report is analysis only — nothing is deleted or moved."
                TextWrapping="Wrap"
                Foreground="{ThemeResource SfTextMutedBrush}" />

            <StackPanel Spacing="4">
                <TextBlock Text="Folder" FontWeight="SemiBold" />
                <TextBlock
                    x:Name="FolderPathText"
                    TextTrimming="CharacterEllipsis"
                    Foreground="{ThemeResource SfTextMutedBrush}"
                    ToolTipService.ToolTip="{Binding Text, ElementName=FolderPathText}" />
            </StackPanel>

            <NumberBox
                x:Name="ThresholdInput"
                Header="Large file threshold (MB)"
                Value="100"
                Minimum="1"
                SmallChange="10"
                LargeChange="100"
                SpinButtonPlacementMode="Compact"
                HorizontalAlignment="Stretch" />
        </StackPanel>

        <!-- Scanning -->
        <StackPanel
            x:Name="PhaseScan"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="Collapsed">
            <TextBlock
                Text="Scanning for large files and duplicate groups…"
                TextWrapping="Wrap" />
            <ProgressBar x:Name="ScanProgress" IsIndeterminate="True" />
            <TextBlock
                x:Name="ScanStatusText"
                Text="Preparing scan"
                Foreground="{ThemeResource SfTextMutedBrush}" />
            <TextBlock
                x:Name="ScanCurrentItem"
                TextWrapping="Wrap"
                TextTrimming="CharacterEllipsis"
                MaxLines="2"
                Foreground="{ThemeResource SfTextMutedBrush}" />
        </StackPanel>

        <!-- Results -->
        <Grid x:Name="PhaseResults" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,12" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Large files" FontSize="12" Foreground="{ThemeResource SfTextMutedBrush}" />
                    <TextBlock x:Name="SummaryLargeFiles" Text="0" FontSize="20" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Duplicate groups" FontSize="12" Foreground="{ThemeResource SfTextMutedBrush}" />
                    <TextBlock x:Name="SummaryDuplicates" Text="0" FontSize="20" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Files scanned" FontSize="12" Foreground="{ThemeResource SfTextMutedBrush}" />
                    <TextBlock x:Name="SummaryScanned" Text="0" FontSize="20" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>

            <Pivot Grid.Row="1">
                <PivotItem Header="Large Files">
                    <Grid>
                        <ListView
                            x:Name="LargeFilesList"
                            SelectionMode="None"
                            IsItemClickEnabled="False">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="8,6" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis"
                                                FontWeight="SemiBold" />
                                            <TextBlock
                                                Text="{Binding Directory}"
                                                TextTrimming="CharacterEllipsis"
                                                FontSize="12"
                                                Foreground="{ThemeResource SfTextMutedBrush}"
                                                ToolTipService.ToolTip="{Binding Path}" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{Binding FormattedSize}"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource SfTextMutedBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock
                            x:Name="LargeFilesEmpty"
                            Text="No files at or above the threshold."
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource SfTextMutedBrush}"
                            Visibility="Collapsed" />
                    </Grid>
                </PivotItem>
                <PivotItem Header="Duplicates">
                    <Grid>
                        <ListView
                            x:Name="DuplicatesList"
                            SelectionMode="None"
                            IsItemClickEnabled="False">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="8,8" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="4">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{Binding HashText}"
                                                FontSize="12"
                                                Foreground="{ThemeResource SfTextMutedBrush}" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Paths}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock
                                                        Text="{Binding}"
                                                        TextTrimming="CharacterEllipsis"
                                                        FontSize="12"
                                                        Foreground="{ThemeResource SfTextMutedBrush}"
                                                        Margin="0,1,0,0" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock
                            x:Name="DuplicatesEmpty"
                            Text="No duplicate files found."
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource SfTextMutedBrush}"
                            Visibility="Collapsed" />
                    </Grid>
                </PivotItem>
            </Pivot>
        </Grid>
    </Grid>
</ContentDialog>
