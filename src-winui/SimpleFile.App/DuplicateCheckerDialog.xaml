<ContentDialog
    x:Class="SimpleFile.App.DuplicateCheckerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Find Duplicates"
    PrimaryButtonText="Start Scan"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick"
    CloseButtonClick="OnCloseButtonClick"
    Loaded="OnLoaded">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">720</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">440</x:Double>
    </ContentDialog.Resources>

    <Grid x:Name="DialogRoot" Width="440">
        <!-- Phase 1: Configuration -->
        <StackPanel x:Name="PhaseConfig" Spacing="16">
            <TextBlock
                Text="Compare file contents in this folder and keep at least one copy of each group."
                TextWrapping="Wrap"
                Foreground="{ThemeResource SfTextMutedBrush}" />
            <StackPanel Spacing="4">
                <TextBlock Text="Folder" FontWeight="SemiBold" />
                <TextBlock x:Name="FolderPathText" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource SfTextMutedBrush}" />
            </StackPanel>
            <NumberBox
                x:Name="MinSizeInput"
                Header="Minimum file size (KB)"
                Value="1"
                Minimum="0"
                SpinButtonPlacementMode="Compact"
                HorizontalAlignment="Stretch" />
            <CheckBox x:Name="IncludeEmptyCheck" Content="Include empty files" />
        </StackPanel>

        <!-- Phase 2: Scanning -->
        <StackPanel x:Name="PhaseScan" VerticalAlignment="Center" Spacing="12" Visibility="Collapsed">
            <TextBlock Text="Scanning for duplicate files…" TextWrapping="Wrap" />
            <ProgressBar x:Name="ScanProgress" IsIndeterminate="True" />
            <TextBlock x:Name="ScanStatusText" Text="Preparing scan" Foreground="{ThemeResource SfTextMutedBrush}" />
            <TextBlock
                x:Name="ScanCurrentItem"
                TextWrapping="Wrap"
                TextTrimming="CharacterEllipsis"
                MaxLines="2"
                Foreground="{ThemeResource SfTextMutedBrush}" />
        </StackPanel>

        <!-- Phase 3: Results -->
        <Grid x:Name="PhaseResults" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Summary cards -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Groups" Foreground="{ThemeResource SfTextMutedBrush}" />
                    <TextBlock x:Name="SummaryGroups" Text="0" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Files" Foreground="{ThemeResource SfTextMutedBrush}" />
                    <TextBlock x:Name="SummaryFiles" Text="0" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Reclaimable" Foreground="{ThemeResource SfTextMutedBrush}" />
                    <TextBlock x:Name="SummaryReclaimable" Text="0 B" FontWeight="Bold" Foreground="{ThemeResource SfAccentBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="Selected" Foreground="{ThemeResource SfTextMutedBrush}" />
                    <TextBlock x:Name="SummarySelected" Text="0 B" FontWeight="Bold" />
                </StackPanel>
            </Grid>

            <!-- Global Actions -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                <Button Content="Keep Newest" Click="GlobalKeepNewest_Click" />
                <Button Content="Keep First" Click="GlobalKeepFirst_Click" />
                <Button Content="Clear Selection" Click="GlobalClear_Click" />
            </StackPanel>

            <!-- ListView of Groups -->
            <ListView x:Name="GroupsList" Grid.Row="2" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,16">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                    <Button Content="Keep Newest" Tag="{Binding}" Click="GroupKeepNewest_Click" Padding="4,2" FontSize="12" />
                                    <Button Content="Keep First" Tag="{Binding}" Click="GroupKeepFirst_Click" Padding="4,2" FontSize="12" />
                                    <Button Content="Clear" Tag="{Binding}" Click="GroupClear_Click" Padding="4,2" FontSize="12" />
                                </StackPanel>
                            </Grid>
                            
                            <!-- Nested items -->
                            <ItemsControl ItemsSource="{Binding Files}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="16,4,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}" Click="FileCheckbox_Click" Tag="{Binding}" VerticalAlignment="Center" />
                                            
                                            <StackPanel Grid.Column="1" Margin="8,0">
                                                <TextBlock Text="{Binding FileName}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Path}" Foreground="{ThemeResource SfTextMutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding SizeAndDate}" Foreground="{ThemeResource SfTextMutedBrush}" FontSize="12" />
                                            </StackPanel>
                                            
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Button Content="👁" Tag="{Binding}" Click="PreviewFile_Click" Padding="4" ToolTipService.ToolTip="Preview" />
                                                <Button Content="▶" Tag="{Binding}" Click="OpenFile_Click" Padding="4" ToolTipService.ToolTip="Open" />
                                                <Button Content="📁" Tag="{Binding}" Click="RevealFile_Click" Padding="4" ToolTipService.ToolTip="Reveal in folder" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Button
                x:Name="TrashButton"
                Grid.Row="3"
                HorizontalAlignment="Right"
                Margin="0,16,0,0"
                Background="#AA0000"
                Content="Move Selected to Trash"
                Foreground="White"
                IsEnabled="False"
                Click="TrashButton_Click" />
        </Grid>
    </Grid>
</ContentDialog>
