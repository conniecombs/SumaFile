<Window
    x:Class="SimpleFile.App.DuplicateCheckerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Find Duplicates">

    <Grid
        x:Name="DialogRoot"
        MinWidth="720"
        MinHeight="520"
        Background="{ThemeResource SfBgPrimaryBrush}"
        Loaded="OnLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Padding="24,18,24,12"
            BorderBrush="{ThemeResource SfBorderBrush}"
            BorderThickness="0,0,0,1">
            <StackPanel Spacing="4">
                <TextBlock
                    x:Name="WindowTitleText"
                    Text="Find Duplicates"
                    FontSize="22"
                    FontWeight="SemiBold" />
                <TextBlock
                    x:Name="FolderPathText"
                    Foreground="{ThemeResource SfTextMutedBrush}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <Grid
            Grid.Row="1"
            Padding="24"
            RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ScrollViewer
                x:Name="PhaseConfig"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto">
                <StackPanel
                    MaxWidth="760"
                    HorizontalAlignment="Stretch"
                    Spacing="16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="12">
                            <NumberBox
                                x:Name="MinSizeInput"
                                Header="Minimum file size (KB)"
                                Value="1"
                                Minimum="0"
                                SpinButtonPlacementMode="Compact"
                                HorizontalAlignment="Stretch" />
                            <CheckBox x:Name="IncludeEmptyCheck" Content="Include empty files" />
                            <NumberBox
                                x:Name="PartialHashInput"
                                Header="Partial hash size (KB)"
                                Value="1024"
                                Minimum="4"
                                Maximum="16384"
                                SpinButtonPlacementMode="Compact"
                                HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="1"
                            Spacing="12">
                            <ComboBox
                                x:Name="NetworkModeBox"
                                Header="Network mode"
                                HorizontalAlignment="Stretch"
                                SelectedIndex="0">
                                <ComboBoxItem Content="Auto" Tag="Auto" />
                                <ComboBoxItem Content="NAS optimized" Tag="On" />
                                <ComboBoxItem Content="Local optimized" Tag="Off" />
                            </ComboBox>
                            <CheckBox
                                x:Name="LimitDepthCheck"
                                Content="Limit folder depth"
                                Checked="LimitDepthCheck_Changed"
                                Unchecked="LimitDepthCheck_Changed" />
                            <NumberBox
                                x:Name="MaxDepthInput"
                                Header="Folder depth"
                                Value="4"
                                Minimum="0"
                                IsEnabled="False"
                                SpinButtonPlacementMode="Compact"
                                HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Grid>

                    <TextBox
                        x:Name="ExcludePatternsTextBox"
                        Header="Skip folders or patterns"
                        AcceptsReturn="True"
                        Height="92"
                        PlaceholderText="@eaDir; #recycle; *.tmp"
                        TextWrapping="Wrap" />

                    <StackPanel
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
                        <Button
                            Content="Cancel"
                            Click="CloseButton_Click" />
                        <Button
                            x:Name="StartScanButton"
                            Content="Start scan"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="StartScanButton_Click" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Grid
                x:Name="PhaseScan"
                MaxWidth="680"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    Text="Scanning for duplicate files"
                    FontSize="18"
                    FontWeight="SemiBold" />
                <ProgressBar
                    x:Name="ScanProgress"
                    Grid.Row="1"
                    Margin="0,16,0,0"
                    IsIndeterminate="True" />
                <TextBlock
                    x:Name="ScanStatusText"
                    Grid.Row="2"
                    Margin="0,12,0,0"
                    Text="Preparing scan"
                    Foreground="{ThemeResource SfTextMutedBrush}" />
                <TextBlock
                    x:Name="ScanCurrentItem"
                    Grid.Row="3"
                    Margin="0,6,0,0"
                    TextWrapping="Wrap"
                    TextTrimming="CharacterEllipsis"
                    MaxLines="2"
                    Foreground="{ThemeResource SfTextMutedBrush}" />
                <Button
                    x:Name="CancelScanButton"
                    Grid.Row="4"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Right"
                    Content="Cancel scan"
                    Click="CancelScanButton_Click" />
            </Grid>

            <Grid
                x:Name="PhaseResults"
                Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Groups" Foreground="{ThemeResource SfTextMutedBrush}" />
                        <TextBlock x:Name="SummaryGroups" Text="0" FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Files" Foreground="{ThemeResource SfTextMutedBrush}" />
                        <TextBlock x:Name="SummaryFiles" Text="0" FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Reclaimable" Foreground="{ThemeResource SfTextMutedBrush}" />
                        <TextBlock x:Name="SummaryReclaimable" Text="0 B" FontWeight="Bold" Foreground="{ThemeResource SfAccentBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Selected" Foreground="{ThemeResource SfTextMutedBrush}" />
                        <TextBlock x:Name="SummarySelected" Text="0 B" FontWeight="Bold" />
                    </StackPanel>
                </Grid>

                <StackPanel
                    Grid.Row="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="0,0,0,12">
                    <Button Content="Keep newest" Click="GlobalKeepNewest_Click" />
                    <Button Content="Keep first" Click="GlobalKeepFirst_Click" />
                    <Button Content="Clear selection" Click="GlobalClear_Click" />
                </StackPanel>

                <ListView
                    x:Name="GroupsList"
                    Grid.Row="2"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,16">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                        <Button Content="Keep newest" Tag="{Binding}" Click="GroupKeepNewest_Click" Padding="4,2" FontSize="12" />
                                        <Button Content="Keep first" Tag="{Binding}" Click="GroupKeepFirst_Click" Padding="4,2" FontSize="12" />
                                        <Button Content="Clear" Tag="{Binding}" Click="GroupClear_Click" Padding="4,2" FontSize="12" />
                                    </StackPanel>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Files}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="16,4,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}" Click="FileCheckbox_Click" Tag="{Binding}" VerticalAlignment="Center" />

                                                <StackPanel Grid.Column="1" Margin="8,0">
                                                    <TextBlock Text="{Binding FileName}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Path}" Foreground="{ThemeResource SfTextMutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding SizeAndDate}" Foreground="{ThemeResource SfTextMutedBrush}" FontSize="12" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <Button Content="Preview" Tag="{Binding}" Click="PreviewFile_Click" Padding="6,3" ToolTipService.ToolTip="Preview" />
                                                    <Button Content="Open" Tag="{Binding}" Click="OpenFile_Click" Padding="6,3" ToolTipService.ToolTip="Open" />
                                                    <Button Content="Reveal" Tag="{Binding}" Click="RevealFile_Click" Padding="6,3" ToolTipService.ToolTip="Reveal in folder" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel
                    Grid.Row="3"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        Content="Close"
                        Click="CloseButton_Click" />
                    <Button
                        x:Name="TrashButton"
                        Background="#AA0000"
                        Content="Move selected to Trash"
                        Foreground="White"
                        IsEnabled="False"
                        Click="TrashButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
