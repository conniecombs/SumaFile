<UserControl
    x:Class="SimpleFile.App.PrimaryToolbarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SimpleFile.App"
    xmlns:core="using:SimpleFile.Core"
    xmlns:ipc="using:SimpleFile.Ipc">
                        <Grid
                            x:Name="PrimaryToolbar"
                            Grid.Row="0"
                            Padding="10,4,10,6"
                            ColumnSpacing="8"
                            SizeChanged="OnPrimaryToolbarSizeChanged">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="PrimaryActionsColumn" Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="PrimaryNavHost" Orientation="Horizontal" Spacing="2">
                                <Button
                                    x:Name="PrimarySidebarToggleButton"
                                    Style="{StaticResource SfToolbarButtonStyle}"
                                    AutomationProperties.Name="Toggle sidebar"
                                    Click="OnToggleSidebar"
                                    ToolTipService.ToolTip="Hide sidebar">
                                    <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="14" Glyph="&#xE700;" />
                                </Button>
                                <Button
                                    x:Name="PrimaryBackButton"
                                    Style="{StaticResource SfToolbarButtonStyle}"
                                    AutomationProperties.Name="Go back"
                                    Click="OnPrimaryBack"
                                    ToolTipService.ToolTip="Back">
                                    <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="14" Glyph="&#xE72B;" />
                                </Button>
                                <Button
                                    x:Name="PrimaryForwardButton"
                                    Style="{StaticResource SfToolbarButtonStyle}"
                                    AutomationProperties.Name="Go forward"
                                    Click="OnPrimaryForward"
                                    ToolTipService.ToolTip="Forward">
                                    <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="14" Glyph="&#xE72A;" />
                                </Button>
                                <Button
                                    x:Name="PrimaryUpButton"
                                    Style="{StaticResource SfToolbarButtonStyle}"
                                    AutomationProperties.Name="Go up"
                                    Click="OnPrimaryUp"
                                    ToolTipService.ToolTip="Up">
                                    <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="14" Glyph="&#xE74A;" />
                                </Button>
                            </StackPanel>
                            <Grid
                                x:Name="OmnibarHost"
                                Grid.Column="1"
                                MinWidth="280"
                                MaxWidth="900"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center">
                                <TextBox
                                    x:Name="OmnibarBox"
                                    Padding="116,4,34,4"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Address and search"
                                    CornerRadius="6"
                                    GotFocus="OnOmnibarGotFocus"
                                    KeyDown="OnOmnibarKeyDown"
                                    LostFocus="OnOmnibarLostFocus"
                                    TextChanged="OnOmnibarTextChanged"
                                    ToolTipService.ToolTip="Path, or >command ?search ~filter"
                                    PlaceholderText="Path, or >command ?search ~filter" />
                                <StackPanel
                                    Margin="2,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="1">
                                    <ToggleButton
                                        x:Name="OmnibarPathModeButton"
                                        Width="28"
                                        Height="28"
                                        MinWidth="28"
                                        Padding="0"
                                        CornerRadius="4"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        AutomationProperties.Name="Path mode"
                                        Click="OnOmnibarPathModeClick"
                                        IsChecked="True"
                                        ToolTipService.ToolTip="Path">
                                        <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="12" Glyph="&#xE8B7;" />
                                    </ToggleButton>
                                    <ToggleButton
                                        x:Name="OmnibarSearchModeButton"
                                        Width="28"
                                        Height="28"
                                        MinWidth="28"
                                        Padding="0"
                                        CornerRadius="4"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        AutomationProperties.Name="Search mode"
                                        Click="OnOmnibarSearchModeClick"
                                        ToolTipService.ToolTip="Search">
                                        <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="12" Glyph="&#xE721;" />
                                    </ToggleButton>
                                    <ToggleButton
                                        x:Name="OmnibarFilterModeButton"
                                        Width="28"
                                        Height="28"
                                        MinWidth="28"
                                        Padding="0"
                                        CornerRadius="4"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        AutomationProperties.Name="Filter mode"
                                        Click="OnOmnibarFilterModeClick"
                                        ToolTipService.ToolTip="Filter">
                                        <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="12" Glyph="&#xE71C;" />
                                    </ToggleButton>
                                    <ToggleButton
                                        x:Name="OmnibarCommandModeButton"
                                        Width="28"
                                        Height="28"
                                        MinWidth="28"
                                        Padding="0"
                                        CornerRadius="4"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        AutomationProperties.Name="Command mode"
                                        Click="OnOmnibarCommandModeClick"
                                        ToolTipService.ToolTip="Commands">
                                        <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="12" Glyph="&#xE945;" />
                                    </ToggleButton>
                                </StackPanel>
                                <StackPanel
                                    Margin="0,0,2,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="1">
                                    <ToggleButton
                                        x:Name="ContentSearchButton"
                                        AllowFocusOnInteraction="False"
                                        Width="28"
                                        Height="28"
                                        MinWidth="28"
                                        Padding="0"
                                        CornerRadius="4"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        AutomationProperties.Name="Search file contents"
                                        Click="OnContentSearchToggle"
                                        ToolTipService.ToolTip="Search file contents"
                                        Visibility="Collapsed">
                                        <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="12" Glyph="&#xE8A5;" />
                                    </ToggleButton>
                                    <Button
                                        x:Name="SearchCancelButton"
                                        AllowFocusOnInteraction="False"
                                        Width="28"
                                        Height="28"
                                        Padding="0"
                                        AutomationProperties.Name="Cancel search"
                                        Click="OnCancelSearchClick"
                                        IsEnabled="False"
                                        Style="{StaticResource SfIconButtonStyle}"
                                        ToolTipService.ToolTip="Cancel search"
                                        Visibility="Collapsed">
                                        <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="11" Glyph="&#xE711;" />
                                    </Button>
                                    <Button
                                        x:Name="OmnibarExecuteButton"
                                        AllowFocusOnInteraction="False"
                                        Width="28"
                                        Height="28"
                                        Padding="0"
                                        AutomationProperties.Name="Run Omnibar input"
                                        Click="OnOmnibarExecuteClick"
                                        Style="{StaticResource SfIconButtonStyle}"
                                        ToolTipService.ToolTip="Run">
                                        <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="12" Glyph="&#xE76C;" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <StackPanel
                                x:Name="PrimaryActionsHost"
                                Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="2">
                                <Button
                                    x:Name="PrimaryNewButton"
                                    Style="{StaticResource SfToolbarButtonStyle}"
                                    AutomationProperties.Name="New"
                                    ToolTipService.ToolTip="New">
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem
                                                Text="Folder"
                                                Tag="new:folder"
                                                Click="OnNewMenuItemClick"
                                                x:Name="NewFolderMenuItem">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="14" Glyph="&#xE8F4;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem
                                                Text="Text document"
                                                Tag="new:text"
                                                Click="OnNewMenuItemClick"
                                                x:Name="NewTextMenuItem">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="14" Glyph="&#xE8A5;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Blank file..." Tag="new:empty" Click="OnNewMenuItemClick">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="14" Glyph="&#xE8A5;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Shortcut..." Tag="new:shortcut" Click="OnNewMenuItemClick">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="14" Glyph="&#xE71B;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                    <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="14" Glyph="&#xE8F4;" />
                                </Button>
                                <Button
                                    x:Name="DualPaneButton"
                                    Style="{StaticResource SfToolbarButtonStyle}"
                                    AutomationProperties.Name="Open second pane"
                                    Click="OnToggleDualPane"
                                    ToolTipService.ToolTip="Open second pane">
                                    <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="14" Glyph="&#xE8A0;" />
                                </Button>
                                <Button
                                    x:Name="ClosePrimaryPaneButton"
                                    Style="{StaticResource SfToolbarButtonStyle}"
                                    AutomationProperties.Name="Close left pane"
                                    Click="OnClosePrimaryPane"
                                    ToolTipService.ToolTip="Close left pane"
                                    Visibility="Collapsed">
                                    <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="12" Glyph="&#xE89F;" />
                                </Button>
                                <Button
                                    x:Name="WorkspaceProfileButton"
                                    Style="{StaticResource SfToolbarButtonStyle}"
                                    AutomationProperties.Name="Workspace profiles"
                                    ToolTipService.ToolTip="Workspace profiles">
                                    <Button.Flyout>
                                        <Flyout Opening="OnWorkspaceProfilesFlyoutOpening">
                                            <StackPanel
                                                MinWidth="300"
                                                Padding="4"
                                                Spacing="8">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontWeight="SemiBold"
                                                        Text="Profiles" />
                                                    <Button
                                                        x:Name="WorkspaceProfileSaveButton"
                                                        Grid.Column="1"
                                                        Style="{StaticResource SfGhostButtonStyle}"
                                                        Click="OnWorkspaceProfileSaveClicked"
                                                        ToolTipService.ToolTip="Save current profile">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <FontIcon
                                                                FontFamily="{StaticResource SfIconFont}"
                                                                FontSize="13"
                                                                Glyph="&#xE74E;" />
                                                            <TextBlock Text="Save" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                                <StackPanel x:Name="WorkspaceProfilesHost" Spacing="2" />
                                                <Button
                                                    x:Name="WorkspaceProfileManageButton"
                                                    Style="{StaticResource SfGhostButtonStyle}"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Click="OnWorkspaceProfileManageClicked">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon
                                                            FontFamily="{StaticResource SfIconFont}"
                                                            FontSize="13"
                                                            Glyph="&#xE713;" />
                                                        <TextBlock Text="Manage profiles..." />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                    <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="14" Glyph="&#xE8AB;" />
                                </Button>
                                <Button
                                    x:Name="PrimaryViewButton"
                                    Style="{StaticResource SfToolbarButtonStyle}"
                                    AutomationProperties.Name="Current view options"
                                    ToolTipService.ToolTip="Current view options">
                                    <Button.Flyout>
                                        <Flyout Opening="OnViewOptionsFlyoutOpening">
                                            <StackPanel
                                                MinWidth="280"
                                                Padding="4"
                                                Spacing="12">
                                                <RadioButtons
                                                    x:Name="ViewStyleRadioButtons"
                                                    Header="Display style"
                                                    MaxColumns="2"
                                                    SelectionChanged="OnViewStyleSelectionChanged">
                                                    <RadioButton Content="Details" Tag="details" />
                                                    <RadioButton Content="List" Tag="list" />
                                                    <RadioButton Content="Tiles" Tag="tiles" />
                                                    <RadioButton Content="Content" Tag="content" />
                                                </RadioButtons>
                                                <StackPanel Spacing="6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Icon size" />
                                                        <TextBlock
                                                            x:Name="ViewIconSizeValueText"
                                                            Grid.Column="1"
                                                            Foreground="{ThemeResource SfTextMutedBrush}" />
                                                    </Grid>
                                                    <!-- The slider moves between the icon-size options (UiSettings.IconSizeOptions), not raw pixels. -->
                                                    <Slider
                                                        x:Name="ViewIconSizeSlider"
                                                        HorizontalAlignment="Stretch"
                                                        AutomationProperties.Name="Icon size"
                                                        IsThumbToolTipEnabled="False"
                                                        LargeChange="1"
                                                        Maximum="4"
                                                        Minimum="0"
                                                        SmallChange="1"
                                                        SnapsTo="Ticks"
                                                        StepFrequency="1"
                                                        TickFrequency="1"
                                                        TickPlacement="Outside"
                                                        ValueChanged="OnViewIconSizeSliderChanged" />
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            x:Name="ViewIconSizeMinLabel"
                                                            FontSize="11"
                                                            Foreground="{ThemeResource SfTextMutedBrush}"
                                                            Text="Small" />
                                                        <TextBlock
                                                            x:Name="ViewIconSizeMaxLabel"
                                                            Grid.Column="1"
                                                            FontSize="11"
                                                            Foreground="{ThemeResource SfTextMutedBrush}"
                                                            Text="Huge" />
                                                    </Grid>
                                                </StackPanel>
                                                <Button
                                                    x:Name="ViewApplyBothButton"
                                                    Style="{StaticResource SfGhostButtonStyle}"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Click="OnViewApplyBothClicked"
                                                    Content="Apply current view to both panes" />
                                                <StackPanel Spacing="6">
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <ComboBox
                                                            x:Name="ViewRememberScopeBox"
                                                            HorizontalAlignment="Stretch"
                                                            Header="Remember this view for"
                                                            SelectedIndex="0">
                                                            <ComboBoxItem Content="Everywhere" Tag="global" />
                                                            <ComboBoxItem x:Name="ViewRememberFolderItem" Content="This folder" Tag="folder" />
                                                            <ComboBoxItem x:Name="ViewRememberDescendantsItem" Content="This folder and subfolders" Tag="descendants" />
                                                        </ComboBox>
                                                        <Button
                                                            x:Name="ViewRememberButton"
                                                            Grid.Column="1"
                                                            VerticalAlignment="Bottom"
                                                            Click="OnViewRememberClicked"
                                                            Content="Remember" />
                                                    </Grid>
                                                    <TextBlock
                                                        x:Name="ViewFolderRuleStatusText"
                                                        FontSize="12"
                                                        Foreground="{ThemeResource SfTextMutedBrush}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                    <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="14" Glyph="&#xE8A9;" />
                                </Button>
                                <Button
                                    x:Name="PrimarySettingsButton"
                                    Style="{StaticResource SfToolbarButtonStyle}"
                                    AutomationProperties.Name="Settings"
                                    Click="OnSettingsClicked"
                                    ToolTipService.ToolTip="Settings">
                                    <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="14" Glyph="&#xE713;" />
                                </Button>
                            </StackPanel>
                            <Button
                                x:Name="PrimaryMoreButton"
                                Grid.Column="3"
                                Style="{StaticResource SfToolbarButtonStyle}"
                                AutomationProperties.Name="More"
                                ToolTipService.ToolTip="More">
                                <Button.Flyout>
                                    <MenuFlyout Opening="OnPrimaryMoreMenuOpening" />
                                </Button.Flyout>
                                <FontIcon FontFamily="{StaticResource SfIconFont}" FontSize="14" Glyph="&#xE712;" />
                            </Button>
                        </Grid>
</UserControl>
