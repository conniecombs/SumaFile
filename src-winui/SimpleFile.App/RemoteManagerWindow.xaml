<Window
    x:Class="SimpleFile.App.RemoteManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="FTP/SFTP Manager">
    <Grid
        x:Name="Root"
        MinWidth="1120"
        MinHeight="520"
        Padding="16"
        Background="{ThemeResource SfBgSecondaryBrush}"
        RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource SfTextPrimaryBrush}"
                    Text="FTP/SFTP manager" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource SfTextMutedBrush}"
                    Text="{Binding SelectedProfileSummary}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button
                Grid.Column="1"
                Click="OnRefreshProfilesClicked"
                Style="{StaticResource SfGhostButtonStyle}"
                ToolTipService.ToolTip="Refresh remote profiles">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon
                        FontFamily="{StaticResource SfIconFont}"
                        FontSize="11"
                        Glyph="&#xE72C;" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
            <Button
                Grid.Column="2"
                Click="OnConnectClicked"
                IsEnabled="{Binding CanConnect}"
                Style="{StaticResource SfGhostButtonStyle}"
                ToolTipService.ToolTip="Connect to selected profile">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon
                        FontFamily="{StaticResource SfIconFont}"
                        FontSize="11"
                        Glyph="&#xE8CE;" />
                    <TextBlock Text="Connect" />
                </StackPanel>
            </Button>
            <Button
                Grid.Column="3"
                Click="OnDisconnectClicked"
                IsEnabled="{Binding CanDisconnect}"
                Style="{StaticResource SfGhostButtonStyle}"
                ToolTipService.ToolTip="Disconnect current remote session">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon
                        FontFamily="{StaticResource SfIconFont}"
                        FontSize="11"
                        Glyph="&#xE711;" />
                    <TextBlock Text="Disconnect" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid
            Grid.Row="1"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Padding="12"
                Background="{ThemeResource SfBgPrimaryBrush}"
                BorderBrush="{ThemeResource SfBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource SfTextPrimaryBrush}"
                            Text="Profiles" />
                        <Button
                            Grid.Column="1"
                            Click="OnNewProfileClicked"
                            IsEnabled="{Binding CanCreateProfile}"
                            Style="{StaticResource SfGhostButtonStyle}"
                            ToolTipService.ToolTip="New remote profile">
                            <FontIcon
                                FontFamily="{StaticResource SfIconFont}"
                                FontSize="11"
                                Glyph="&#xE710;" />
                        </Button>
                        <Button
                            Grid.Column="2"
                            Click="OnEditProfileClicked"
                            IsEnabled="{Binding CanEditProfile}"
                            Style="{StaticResource SfGhostButtonStyle}"
                            ToolTipService.ToolTip="Edit selected remote profile">
                            <FontIcon
                                FontFamily="{StaticResource SfIconFont}"
                                FontSize="11"
                                Glyph="&#xE70F;" />
                        </Button>
                        <Button
                            Grid.Column="3"
                            Click="OnDeleteProfileClicked"
                            IsEnabled="{Binding CanDeleteProfile}"
                            Style="{StaticResource SfGhostButtonStyle}"
                            ToolTipService.ToolTip="Delete selected remote profile">
                            <FontIcon
                                FontFamily="{StaticResource SfIconFont}"
                                FontSize="11"
                                Glyph="&#xE74D;" />
                        </Button>
                    </Grid>
                    <ListView
                        x:Name="RemoteProfileList"
                        Grid.Row="1"
                        ItemsSource="{Binding Profiles}"
                        SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel MinWidth="0" Spacing="3">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource SfTextPrimaryBrush}"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource SfTextMutedBrush}"
                                        Text="{Binding Host}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                Padding="12"
                Background="{ThemeResource SfBgPrimaryBrush}"
                BorderBrush="{ThemeResource SfBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="LocalPathBox"
                            IsReadOnly="True"
                            PlaceholderText="Choose a local folder"
                            Style="{StaticResource SfTextBoxStyle}"
                            Text="{Binding LocalPath, Mode=OneWay}" />
                        <Button
                            Grid.Column="1"
                            Click="OnLocalUpClicked"
                            Style="{StaticResource SfGhostButtonStyle}"
                            ToolTipService.ToolTip="Go to parent local folder">
                            <FontIcon
                                FontFamily="{StaticResource SfIconFont}"
                                FontSize="11"
                                Glyph="&#xE74A;" />
                        </Button>
                        <Button
                            Grid.Column="2"
                            Click="OnChooseLocalFolderClicked"
                            Style="{StaticResource SfGhostButtonStyle}"
                            ToolTipService.ToolTip="Choose local folder">
                            <FontIcon
                                FontFamily="{StaticResource SfIconFont}"
                                FontSize="11"
                                Glyph="&#xE8B7;" />
                        </Button>
                        <Button
                            Grid.Column="3"
                            Click="OnUploadSelectedLocalEntriesClicked"
                            IsEnabled="{Binding CanUseWorkspaceTransfers}"
                            Style="{StaticResource SfGhostButtonStyle}"
                            ToolTipService.ToolTip="Upload selected local files to remote pane">
                            <FontIcon
                                FontFamily="{StaticResource SfIconFont}"
                                FontSize="11"
                                Glyph="&#xE898;" />
                        </Button>
                        <Button
                            Grid.Column="4"
                            Click="OnRefreshLocalClicked"
                            Style="{StaticResource SfGhostButtonStyle}"
                            ToolTipService.ToolTip="Refresh local folder">
                            <FontIcon
                                FontFamily="{StaticResource SfIconFont}"
                                FontSize="11"
                                Glyph="&#xE72C;" />
                        </Button>
                    </Grid>
                    <ListView
                        x:Name="LocalEntryList"
                        Grid.Row="1"
                        IsItemClickEnabled="True"
                        ItemClick="OnLocalEntryItemClick"
                        ItemsSource="{Binding LocalEntries}"
                        SelectionMode="Extended">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid MinWidth="0" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="96" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        FontSize="13"
                                        Foreground="{ThemeResource SfTextPrimaryBrush}"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        FontSize="12"
                                        Foreground="{ThemeResource SfTextMutedBrush}"
                                        Text="{Binding Modified}"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border
                Grid.Column="2"
                Padding="12"
                Background="{ThemeResource SfBgPrimaryBrush}"
                BorderBrush="{ThemeResource SfBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="RemotePathBox"
                            IsReadOnly="True"
                            Style="{StaticResource SfTextBoxStyle}"
                            Text="{Binding RemotePath, Mode=OneWay}" />
                        <Button
                            Grid.Column="1"
                            Click="OnRemoteUpClicked"
                            IsEnabled="{Binding CanMutateRemoteEntries}"
                            Style="{StaticResource SfGhostButtonStyle}"
                            ToolTipService.ToolTip="Go to parent remote folder">
                            <FontIcon
                                FontFamily="{StaticResource SfIconFont}"
                                FontSize="11"
                                Glyph="&#xE74A;" />
                        </Button>
                        <Button
                            Grid.Column="2"
                            Click="OnCreateRemoteDirectoryClicked"
                            IsEnabled="{Binding CanMutateRemoteEntries}"
                            Style="{StaticResource SfGhostButtonStyle}"
                            ToolTipService.ToolTip="Create remote folder">
                            <FontIcon
                                FontFamily="{StaticResource SfIconFont}"
                                FontSize="11"
                                Glyph="&#xE8F4;" />
                        </Button>
                        <Button
                            Grid.Column="3"
                            Click="OnUploadSelectedLocalEntriesClicked"
                            IsEnabled="{Binding CanUseWorkspaceTransfers}"
                            Style="{StaticResource SfGhostButtonStyle}"
                            ToolTipService.ToolTip="Upload selected local files to remote pane">
                            <FontIcon
                                FontFamily="{StaticResource SfIconFont}"
                                FontSize="11"
                                Glyph="&#xE898;" />
                        </Button>
                        <Button
                            Grid.Column="4"
                            Click="OnDownloadSelectedRemoteEntriesClicked"
                            IsEnabled="{Binding CanUseWorkspaceTransfers}"
                            Style="{StaticResource SfGhostButtonStyle}"
                            ToolTipService.ToolTip="Download selected remote files to local pane">
                            <FontIcon
                                FontFamily="{StaticResource SfIconFont}"
                                FontSize="11"
                                Glyph="&#xE896;" />
                        </Button>
                        <Button
                            Grid.Column="5"
                            Click="OnRenameRemoteEntryClicked"
                            IsEnabled="{Binding CanMutateRemoteEntries}"
                            Style="{StaticResource SfGhostButtonStyle}"
                            ToolTipService.ToolTip="Rename selected remote item">
                            <FontIcon
                                FontFamily="{StaticResource SfIconFont}"
                                FontSize="11"
                                Glyph="&#xE8AC;" />
                        </Button>
                        <Button
                            Grid.Column="6"
                            Click="OnDeleteRemoteEntriesClicked"
                            IsEnabled="{Binding CanMutateRemoteEntries}"
                            Style="{StaticResource SfGhostButtonStyle}"
                            ToolTipService.ToolTip="Delete selected remote items">
                            <FontIcon
                                FontFamily="{StaticResource SfIconFont}"
                                FontSize="11"
                                Glyph="&#xE74D;" />
                        </Button>
                        <Button
                            Grid.Column="7"
                            Click="OnRefreshRemoteClicked"
                            IsEnabled="{Binding CanDisconnect}"
                            Style="{StaticResource SfGhostButtonStyle}"
                            ToolTipService.ToolTip="Refresh remote directory">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon
                                    FontFamily="{StaticResource SfIconFont}"
                                    FontSize="11"
                                    Glyph="&#xE72C;" />
                                <TextBlock Text="Reload" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <ListView
                        x:Name="RemoteEntryList"
                        Grid.Row="1"
                        IsItemClickEnabled="True"
                        ItemClick="OnRemoteEntryItemClick"
                        ItemsSource="{Binding RemoteEntries}"
                        SelectionMode="Extended">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid MinWidth="0" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="96" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        FontSize="13"
                                        Foreground="{ThemeResource SfTextPrimaryBrush}"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        FontSize="12"
                                        Foreground="{ThemeResource SfTextMutedBrush}"
                                        Text="{Binding Modified}"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <ListView
                        x:Name="RemoteTransferList"
                        Grid.Row="2"
                        MaxHeight="112"
                        ItemsSource="{Binding Transfers}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid MinWidth="0" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource SfTextMutedBrush}"
                                        Text="{Binding Direction}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        FontSize="12"
                                        Foreground="{ThemeResource SfTextPrimaryBrush}"
                                        Text="{Binding FileName}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="2"
                                        HorizontalAlignment="Right"
                                        FontSize="12"
                                        Foreground="{ThemeResource SfTextMutedBrush}"
                                        Text="{Binding Status}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <TextBlock
            Grid.Row="2"
            FontSize="12"
            Foreground="{ThemeResource SfTextMutedBrush}"
            Text="{Binding StatusText}" />
    </Grid>
</Window>
