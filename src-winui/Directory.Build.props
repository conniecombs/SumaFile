<Project>
  <PropertyGroup>
    <!-- Numeric identity for AssemblyVersion / FileVersion / WiX / NSIS VIProductVersion. -->
    <Version>1.0.0</Version>
    <!-- User-facing product version (About, Settings, installer DisplayVersion, artifact names). -->
    <InformationalVersion>1.0.0</InformationalVersion>
    <Authors>SumaFile Team</Authors>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
</Project>
