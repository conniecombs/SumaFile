<Project>
  <PropertyGroup>
    <!-- Numeric identity for AssemblyVersion / FileVersion / WiX / NSIS VIProductVersion. -->
    <Version>1.0.3</Version>
    <!-- User-facing product version (About, Settings, installer DisplayVersion, artifact names). -->
    <InformationalVersion>1.0.3</InformationalVersion>
    <Authors>SumaFile Team</Authors>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <!-- Keep Debug restore and self-contained release publish on the same lock graph. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!--
      NU1900 only means the NuGet vulnerability audit source (api.nuget.org) could not be
      reached. Keep the audit itself on (NU1901-NU1904 still surface when online) but do
      not let an offline restore spam every project with a warning or fail the build.
    -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900</WarningsNotAsErrors>
    <NoWarn>$(NoWarn);NU1900</NoWarn>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
</Project>
