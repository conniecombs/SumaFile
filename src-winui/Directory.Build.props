<Project>
  <PropertyGroup>
    <!-- Numeric identity for AssemblyVersion / FileVersion / WiX / NSIS VIProductVersion. -->
    <Version>1.0.1</Version>
    <!-- User-facing product version (About, Settings, installer DisplayVersion, artifact names). -->
    <InformationalVersion>1.0.1</InformationalVersion>
    <Authors>SumaFile Team</Authors>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <!-- Keep Debug restore and self-contained release publish on the same lock graph. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- Keep transient NuGet audit metadata outages from breaking local restores. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900</WarningsNotAsErrors>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
</Project>
