<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>SimpleFile.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SimpleFile.Ipc\SimpleFile.Ipc.csproj" />
    <ProjectReference Include="..\SimpleFile.Core\SimpleFile.Core.csproj" />
    <ProjectReference Include="..\SimpleFile.PluginSdk\SimpleFile.PluginSdk.csproj" />
    <ProjectReference Include="..\SimpleFile.PluginHost\SimpleFile.PluginHost.csproj" />
    <!-- The remote plugin's WinUI-free model (net10.0-windows): its view model and backend client tests. -->
    <ProjectReference Include="..\..\plugins\remote\ui\SumaFile.Remote.Model\SumaFile.Remote.Model.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Hello targets 19041 (it builds WinUI code); the test project only needs it built, never referenced. -->
    <ProjectReference Include="Fixtures\HelloPlugin\SimpleFile.Tests.Fixtures.HelloPlugin.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Fixtures\HelloPlugin\**" />
    <None Remove="Fixtures\HelloPlugin\**" />
    <Content Remove="Fixtures\HelloPlugin\**" />
    <EmbeddedResource Remove="Fixtures\HelloPlugin\**" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Fixtures\PluginSdkSurface.v1.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyHelloFixture" AfterTargets="Build">
    <MSBuild Projects="Fixtures\HelloPlugin\SimpleFile.Tests.Fixtures.HelloPlugin.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_HelloPluginTargetPath" />
    </MSBuild>
    <Error Condition="!Exists('@(_HelloPluginTargetPath)')" Text="Hello fixture plugin output not found at @(_HelloPluginTargetPath)." />
    <PropertyGroup>
      <HelloOut>%(_HelloPluginTargetPath.RootDir)%(_HelloPluginTargetPath.Directory)</HelloOut>
      <HelloDest>$(OutDir)Fixtures\plugins\com.sumafile.hello\</HelloDest>
    </PropertyGroup>
    <ItemGroup>
      <HelloFile Include="$(HelloOut)SimpleFile.Tests.Fixtures.HelloPlugin.dll;$(HelloOut)SimpleFile.Tests.Fixtures.HelloPlugin.deps.json;$(HelloOut)plugin.json" />
    </ItemGroup>
    <Copy SourceFiles="@(HelloFile)" DestinationFolder="$(HelloDest)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\target\debug\hello-plugin-backend.exe" DestinationFolder="$(HelloDest)" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildThisFileDirectory)..\..\target\debug\hello-plugin-backend.exe')" />
  </Target>
</Project>
