{
  "id": "com.sumafile.hello",
  "name": "Hello fixture",
  "version": "0.1.0",
  "publisher": { "name": "SumaFile Team" },
  "sdkVersion": "1.0.0",
  "ui": { "assembly": "SimpleFile.Tests.Fixtures.HelloPlugin.dll", "entryType": "SimpleFile.Tests.Fixtures.HelloPlugin.HelloPlugin" },
  "backend": { "executable": "hello-plugin-backend.exe", "args": [], "activateOn": "first-call", "acceptsMultipleClients": true },
  "permissions": ["backend-process"],
  "contributions": {
    "commands": [
      { "id": "greet", "label": "Hello: greet", "group": "Hello" },
      { "id": "backend-ping", "label": "Hello: ping backend", "group": "Hello" },
      { "id": "open-window", "label": "Hello: open window", "group": "Hello" },
      { "id": "show-dialog", "label": "Hello: show dialog", "group": "Hello" },
      { "id": "toggle-panel", "label": "Hello: toggle panel", "group": "Hello" },
      { "id": "show-bottom", "label": "Hello: show bottom panel", "group": "Hello" }
    ],
    "contextMenu": [ { "group": "Hello", "items": [ { "command": "greet", "label": "Say hello", "when": "selectionCount >= 1" } ] } ],
    "toolbar": [ { "command": "greet", "label": "Hello", "glyph": "", "placement": "overflow" } ],
    "archiveFormats": [ { "extension": ".hello", "canList": true, "canExtract": true, "canCreate": true, "canModify": true, "engineName": "hello" } ],
    "sidebar": [ { "id": "hello", "title": "Hello section", "provider": "hello-section", "command": "greet" } ],
    "settingsPage": { "provider": "hello-page" },
    "panels": [
      { "id": "hello-panel", "title": "Hello panel", "provider": "hello-panel", "placement": "right", "detachable": true, "command": "toggle-panel" },
      { "id": "hello-bottom", "title": "Hello bottom", "provider": "hello-bottom", "placement": "bottom", "detachable": false }
    ]
  },
  "settings": [
    { "key": "greeting", "type": "string", "label": "Greeting", "default": "Hello", "group": "General" },
    { "key": "loud", "type": "boolean", "label": "Shout", "default": false, "group": "General" }
  ]
}
