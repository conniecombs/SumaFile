<Project>
  <!--
    In the SumaFile repository the template shares src-winui's build settings (warnings as errors, nullable, lock
    files, the win-x64 lock graph). A copy outside the repository gets the same defaults from the group below.
  -->
  <PropertyGroup>
    <_SumaFileBuildProps>$(MSBuildThisFileDirectory)..\..\..\src-winui\Directory.Build.props</_SumaFileBuildProps>
  </PropertyGroup>
  <Import Project="$(_SumaFileBuildProps)" Condition="Exists('$(_SumaFileBuildProps)')" />
  <PropertyGroup Condition="!Exists('$(_SumaFileBuildProps)')">
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <PropertyGroup>
    <!-- The plugin versions on its own; plugin.json and backend/Cargo.toml carry the same version. -->
    <Version>0.1.0</Version>
    <InformationalVersion>0.1.0</InformationalVersion>
    <Authors>Example Publisher</Authors>
  </PropertyGroup>
</Project>
