{
  "version": 1,
  "description": "Image formats the media process (sumafile-media) decodes for thumbnails and previews, and the video extensions the video process (sumafile-video) makes thumbnails of.",
  "video": [
    "mp4", "m4v", "mov", "qt", "webm", "mkv", "mk3d", "avi", "wmv", "asf",
    "mpg", "mpeg", "mpe", "m2v", "m2ts", "mts", "vob", "flv", "f4v",
    "3gp", "3g2", "ogv", "divx", "mxf", "rm", "rmvb", "h264", "h265", "hevc", "y4m"
  ],
  "formats": [
    { "name": "Photoshop", "extensions": ["psd", "psb"] },
    { "name": "OpenEXR", "extensions": ["exr"] },
    { "name": "Radiance HDR", "extensions": ["hdr"] },
    { "name": "JPEG XL", "extensions": ["jxl"] },
    { "name": "TIFF", "extensions": ["tif", "tiff"] },
    { "name": "SVG", "extensions": ["svg"] },
    { "name": "DirectDraw Surface", "extensions": ["dds"] },
    { "name": "Targa", "extensions": ["tga"] },
    { "name": "QOI", "extensions": ["qoi"] },
    { "name": "Portable anymap", "extensions": ["pnm", "pbm", "pgm", "ppm", "pam"] },
    { "name": "Krita", "extensions": ["kra"] },
    { "name": "OpenRaster", "extensions": ["ora"] },
    {
      "name": "Camera RAW",
      "extensions": [
        "dng", "nef", "nrw", "cr2", "cr3", "arw", "srf", "sr2", "pef",
        "srw", "orf", "rw2", "raf", "erf", "3fr", "mos", "dcr", "kdc"
      ]
    }
  ]
}
