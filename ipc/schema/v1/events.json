{
  "protocolVersion": 1,
  "emitted": {
    "transfer-changes": {
      "params": "TransferChangeChunk",
      "source": "crates/simplefile-service/src/session/jobs.rs",
      "notes": "Reliable ordered merge Undo receipt chunks preceding the terminal transfer response. result_index indexes result or error.data.committed."
    },
    "transfer-tuning": {
      "params": "TuningUpdate",
      "source": "crates/simplefile-service/src/progress/parallel.rs"
    },
    "file-change": {
      "params": "FileChangeEvent",
      "source": "crates/simplefile-service/src/watcher.rs",
      "binaryFrameTag": 6
    },
    "operation-progress": {
      "params": "ProgressUpdate",
      "source": ["crates/simplefile-service/src/progress.rs", "crates/simplefile-service/src/session/jobs.rs"],
      "statusValues": ["running", "finalizing", "completed", "error", "cancelled"],
      "binaryFrameTag": 5
    },
    "search-results-batch": {
      "params": "SearchResultsBatchEvent",
      "source": "crates/simplefile-service/src/search.rs",
      "binaryFrameTag": 3
    },
    "search-complete": {
      "params": "SearchCompleteEvent",
      "source": "crates/simplefile-service/src/search.rs",
      "notes": "Emitted for WinUI clients subscribed during search_files."
    },
    "update-chunk": {
      "params": { "type": "tuple", "items": ["number", "number|null"] },
      "source": "crates/simplefile-service/src/session.rs",
      "notes": "Positional array [bytesDownloaded, totalBytes|null] matching UpdateChunkPayload."
    },
    "listing-view-changed": {
      "params": "ListingViewDelta",
      "source": "crates/simplefile-service/src/listing_views.rs",
      "notes": "A watched folder changed: the rows that moved in every open view of it, or reset=true."
    },
    "entry-facts": { "params": "EntryFactsBatch", "source": "crates/simplefile-service/src/session/fact_jobs.rs", "notes": "A batch of lazy column values for one get_entry_facts request, flushed every 16 facts or 50 ms." },
    "list_directory.chunk": {
      "params": "DirectoryListingChunkNotification",
      "source": "replaces tauri::ipc::Channel on list_directory",
      "chunkSizes": { "first": 96, "later": 256 },
      "binaryFrameTag": 1
    }
  },
  "typedNotEmitted": {
    "operation-complete": {
      "reason": "Present on TauriEventMap only. Completion is ProgressUpdate.status plus the command result.",
      "compatOnly": true
    },
    "operation-error": {
      "reason": "Present on TauriEventMap only. Errors are ProgressUpdate.status === error plus Err(String).",
      "compatOnly": true
    }
  },
  "hostOnly": {
    "tauri://drag-enter": {
      "replacement": "WinUI DragEnter",
      "params": "NativeFileDropEventPayload"
    },
    "tauri://drag-drop": {
      "replacement": "WinUI Drop",
      "params": "NativeFileDropEventPayload"
    },
    "tauri://drag-leave": {
      "replacement": "WinUI DragLeave",
      "params": "NativeFileDropEventPayload"
    }
  },
  "serviceNotifications": {
    "app.restart-required": {
      "params": { "type": "object", "fields": [] },
      "notes": "WinUI-era install_update completion. Not a current Tauri event. UI exits; NSIS relaunches. Do not emit from the Tauri host."
    }
  }
}
