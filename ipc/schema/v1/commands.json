    "unwatch_directory": { "params": null, "result": "null" },
    "read_file_preview": { "params": { "path": "string", "maxSize": "number?" }, "result": "FilePreview" },
    "generate_thumbnail": {
      "params": { "path": "string", "size": "number", "positionPercent": "number?" },
      "result": "string",
      "binaryFrameTag": 7,
      "notes": "positionPercent is for a video: how far into it the thumbnail's frame is, 1 to 99, and 25 when absent. A picture ignores it. A video's thumbnail is made by the video process (sumafile-video)."
    },
    "generate_thumbnails": { "params": { "paths": "string[]", "size": "number" }, "result": "ThumbnailResult[]", "binaryFrameTag": 8 },
    "render_image_preview": {
      "params": { "path": "string", "maxDimension": "number?" },
      "result": "EncodedImage",
      "binaryFrameTag": 10,
      "notes": "A picture for the preview pane, in a format the media process (sumafile-media) decodes. maxDimension is the long side: 2560 when absent, kept between 64 and 8192. JSON form: data is base64."
    },
