      "result": "TransferResult[]",
      "progressEvent": "operation-progress"
    },
    "move_with_progress": {
      "params": {
        "sources": "string[]",
        "destination": "string",
        "operationId": "string?",
        "conflictAction": "ConflictAction",
      "items": "TransferItemRequest[]?"
      },
      "result": "TransferResult[]",
      "progressEvent": "operation-progress"
    },
