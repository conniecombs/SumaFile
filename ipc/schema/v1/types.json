{
  "protocolVersion": 1,
  "casing": {
    "topLevelParams": "camelCase",
    "nestedAndResults": "snake_case",
    "doNotCamelCaseNested": true
  },
  "enums": {
    "ConflictAction": ["error", "skip", "replace", "rename", "keep-both", "keep_both"],
    "ListDirectoryMode": ["full", "light"],
    "DriveListMode": ["full", "light"],
    "ProgressStatus": ["running", "finalizing", "completed", "error", "cancelled"],
    "FileChangeKind": ["create", "modify", "remove", "rename"],
    "ArchiveFormat": ["zip", "7z", "tar", "tar.gz", "tgz", "rar"]
    ,
    "RemoteProtocol": ["sftp", "ftp", "ftps"],
    "RemoteAuthKind": ["password", "private-key", "agent", "anonymous"]
  },
  "frontendOnlyFields": {
    "FileEntry": ["itemCount"],
    "Tag": ["emoji", "label"]
  },
  "types": {
    "FileEntry": {
      "source": "crates/simplefile-core/src/models.rs",
      "fields": ["name", "path", "is_dir", "is_symlink", "is_hidden", "is_system", "size", "modified", "extension", "permissions", "symlink_target", "git_status"],
      "optional": ["is_hidden", "is_system", "permissions", "symlink_target", "git_status"]
    },
    "DirectoryListing": {
      "source": "crates/simplefile-core/src/models.rs",
      "fields": ["path", "parent", "entries", "is_network"],
      "notes": "entries can be empty on successful streamed requests when list_directory.params.finalEntries is false."
    },
    "ListDirectoryOptions": {
      "source": "crates/simplefile-core/src/dir_list.rs",
      "fields": ["mode", "finalEntries", "sortBy", "sortAscending", "filter", "includeHidden"],
      "optional": ["mode", "finalEntries", "sortBy", "sortAscending", "filter", "includeHidden"]
    },
    "DirectoryListingChunk": {
      "source": "crates/simplefile-core/src/models.rs",
      "fields": ["path", "parent", "entries", "chunk_index", "done", "is_network"]
    },
    "ProgressUpdate": {
      "source": "crates/simplefile-core/src/models.rs",
      "fields": ["operation_id", "operation_type", "current", "total", "current_files", "total_files", "current_item", "status", "error"]
    },
    "FileChangeEvent": {
      "source": "crates/simplefile-core/src/models.rs",
      "fields": ["path", "kind"]
    },
    "DriveInfo": {
      "source": "crates/simplefile-core/src/models.rs",
      "fields": ["name", "path", "drive_type", "total_space", "free_space", "remote_path", "drive_status", "status_detail"]
    },
    "SettingMap": {
      "source": "crates/simplefile-core/src/settings_store.rs",
      "fields": ["key", "value"],
      "notes": "JSON object keyed by setting name; missing settings are present with null values."
    },
    "TreeNode": {
      "source": "crates/simplefile-core/src/models.rs",
      "fields": ["name", "path", "has_children", "children"]
    },
    "FolderMetrics": {
      "source": "crates/simplefile-core/src/models.rs",
      "fields": ["size", "item_count", "subdirectories"]
    },
    "SearchResult": {
      "source": "crates/simplefile-core/src/models.rs",
      "fields": ["name", "path", "is_dir", "size", "modified", "extension", "match_type"]
    },
    "SearchResultsBatchEvent": {
      "source": "crates/simplefile-service/src/session/jobs.rs",
      "fields": ["search_id", "results"],
      "optional": ["search_id"],
      "notes": "search_id lets clients ignore stale batches from superseded searches."
    },
    "SearchCompleteEvent": {
      "source": "crates/simplefile-service/src/session/jobs.rs",
      "fields": ["search_id", "count"],
      "optional": ["search_id"],
      "notes": "search_id lets clients ignore stale completion events from superseded searches."
    },
    "SearchOptions": {
      "source": "crates/simplefile-core/src/models.rs",
      "fields": ["query", "search_path", "case_sensitive", "include_hidden", "file_types", "max_results", "max_depth", "search_id", "content_search", "min_size", "max_size", "date_after", "date_before"],
      "optional": ["file_types", "max_results", "max_depth", "search_id", "min_size", "max_size", "date_after", "date_before"]
    },
    "SmartFolder": {
      "source": "crates/simplefile-core/src/models.rs",
      "fields": ["id", "name", "icon", "search_options"]
    },
    "Tag": {
      "source": "crates/simplefile-core/src/models.rs",
      "fields": ["id", "name", "color"]
    },
    "DuplicateGroup": {
      "source": "crates/simplefile-core/src/models.rs",
      "fields": ["hash", "files"]
    },
    "CleanupFile": {
      "source": "crates/simplefile-core/src/models.rs",
      "fields": ["path", "size"]
    },
    "CleanupResult": {
      "source": "crates/simplefile-core/src/models.rs",
      "fields": ["large_files", "duplicates", "scanned_files"]
    },
    "DuplicateCheckFile": {
      "source": "crates/simplefile-core/src/models.rs",
      "fields": ["path", "name", "size", "modified"]
    },
    "DuplicateCheckGroup": {
      "source": "crates/simplefile-core/src/models.rs",
      "fields": ["id", "hash", "size", "wasted_bytes", "files"]
    },
    "DuplicateCheckResult": {
      "source": "crates/simplefile-core/src/models.rs",
      "fields": ["groups", "scanned_files", "candidate_files", "hashed_files", "skipped_files", "errors", "total_reclaimable_bytes"]
    },
    "GitStatus": {
      "source": "crates/simplefile-core/src/models.rs",
      "fields": ["is_repo", "branch", "modified", "staged", "untracked", "ahead", "behind"]
    },
    "GitFileStatus": {
      "source": "crates/simplefile-core/src/models.rs",
      "fields": ["path", "absolute_path", "original_path", "status", "index_status", "worktree_status", "staged", "unstaged", "untracked", "conflicted"],
      "optional": ["original_path"]
    },
    "GitRepositoryStatus": {
      "source": "crates/simplefile-core/src/models.rs",
      "fields": ["is_repo", "root", "branch", "upstream", "head", "ahead", "behind", "staged", "unstaged", "untracked", "conflicted", "changes"],
      "optional": ["root", "branch", "upstream", "head"]
    },
    "GitCommandResult": {
      "source": "crates/simplefile-core/src/models.rs",
      "fields": ["command", "exit_code", "stdout", "stderr", "summary"]
    },
    "FilePreview": {
      "source": "crates/simplefile-core/src/models.rs",
      "fields": ["file_type", "mime_type", "size", "content", "encoding"]
    },
    "ThumbnailResult": {
      "source": "crates/simplefile-core/src/models.rs",
      "fields": ["path", "data", "error"]
    },
    "ImageMetadata": {
      "source": "crates/simplefile-core/src/models.rs",
      "fields": ["width", "height", "exif"]
    },
    "FileMetadata": {
      "source": "crates/simplefile-core/src/models.rs",
      "fields": ["kind", "summary", "fields"]
    },
    "ArchiveEntry": {
      "source": "crates/simplefile-core/src/models.rs",
      "fields": ["name", "path", "is_dir", "size", "compressed_size"]
    },
    "ArchiveInfo": {
      "source": "crates/simplefile-core/src/models.rs",
      "fields": ["path", "format", "entries", "unsafe_entries", "total_size", "compressed_size"]
    },
    "ArchiveFormatCapability": {
      "source": "crates/simplefile-core/src/models.rs",
      "fields": ["format", "extension", "can_list", "can_extract", "can_create", "can_modify", "engine", "note"],
      "optional": ["note"]
    },
    "ArchiveCapabilities": {
      "source": "crates/simplefile-core/src/models.rs",
      "fields": ["formats"]
    },
    "RemoteProfile": {
      "source": "crates/simplefile-core/src/remote/models.rs",
      "fields": ["id", "name", "protocol", "host", "port", "username", "root_path", "auth_kind", "insecure_plain_ftp", "passive_mode", "credential_target", "private_key_path", "trusted_host_fingerprint"],
      "optional": ["credential_target", "private_key_path", "trusted_host_fingerprint"]
    },
    "RemoteProfileInput": {
      "source": "crates/simplefile-core/src/remote/models.rs",
      "fields": ["id", "name", "protocol", "host", "port", "username", "root_path", "auth_kind", "insecure_plain_ftp", "passive_mode", "credential_target", "private_key_path", "trusted_host_fingerprint"],
      "optional": ["id", "credential_target", "private_key_path", "trusted_host_fingerprint"]
    },
    "RemoteConnectionTestResult": {
      "source": "crates/simplefile-service/src/remote/session.rs",
      "fields": ["ok", "message", "capabilities"]
    },
    "RemoteSession": {
      "source": "crates/simplefile-service/src/remote/session.rs",
      "fields": ["session_id", "profile_id", "protocol", "root_path"]
    },
    "RenameRequest": {
      "source": "crates/simplefile-core/src/file_ops.rs",
      "fields": ["path", "new_name"]
    },
    "TransferResult": {
      "source": "crates/simplefile-service/src/progress.rs",
      "fields": ["source", "destination"]
    },
    "TransferFailure": {
      "source": "crates/simplefile-service/src/progress.rs",
      "fields": ["source", "error"]
    },
    "TransferBatchOutcome": {
      "source": "crates/simplefile-service/src/progress.rs",
      "fields": ["operation_id", "status", "committed", "skipped", "failed", "pending"],
      "notes": "Returned as JSON-RPC error.data for copy_with_progress and move_with_progress failures so clients can register safe undo for committed items and retry pending sources."
    },
    "Checksums": {
      "source": "crates/simplefile-core/src/checksum.rs",
      "fields": ["md5", "sha1", "sha256"]
    },
    "DiffRow": {
      "source": "crates/simplefile-core/src/compare.rs",
      "fields": ["kind", "left_line", "right_line", "left_text", "right_text"]
    },
    "BinaryDiffRow": {
      "source": "crates/simplefile-core/src/compare.rs",
      "fields": ["offset", "left_hex", "right_hex", "left_ascii", "right_ascii", "different"]
    },
    "FileComparison": {
      "source": "crates/simplefile-core/src/compare.rs",
      "fields": ["left_path", "right_path", "left_name", "right_name", "left_size", "right_size", "identical", "added", "removed", "changed", "comparison_type", "compared_bytes", "different_bytes", "first_difference", "binary_rows_truncated", "rows", "binary_rows"]
    },
    "UpdateInfo": {
      "source": "crates/simplefile-core/src/models.rs",
      "fields": ["version", "date", "body", "installable", "channel", "url", "sha256", "size"]
    },
    "AppAboutInfo": {
      "source": "crates/simplefile-core/src/models.rs",
      "fields": ["name", "version", "identifier", "os", "arch", "authors", "repository"]
    },
    "DirectoryListingChunkNotification": {
      "source": "architecture list_directory.chunk",
      "fields": ["requestId", "path", "parent", "entries", "chunk_index", "done", "is_network"],
      "notes": "requestId is the JSON-RPC id of the in-flight list_directory call. Remaining fields match DirectoryListingChunk."
    }
  }
}
