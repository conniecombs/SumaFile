{
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:winui",
    "build": "npm run release:build",
    "generate:ipc-bindings": "node scripts/generate-ipc-bindings.mjs",
    "generate:open-with-policy": "node scripts/generate-open-with-policy.mjs",
    "check:ipc-generated": "node scripts/generate-ipc-bindings.mjs --check",
    "check:open-with-policy": "node scripts/generate-open-with-policy.mjs --check",
    "check:ipc-schema": "node scripts/check-ipc-schema.mjs",
    "check:identity": "node scripts/check-sumafile-identity.mjs",
    "check:updater": "node scripts/check-updater-config.mjs",
    "check:workflows": "node scripts/check-github-workflows.mjs",
    "check:provider-surface": "node scripts/check-provider-surface.mjs",
    "check:windows-assets": "node scripts/check-windows-assets.mjs",
    "check:winui-packaging": "node scripts/check-winui-packaging.mjs",
    "check:winui-parity-gate": "node scripts/check-winui-parity-gate.mjs",
    "check": "npm run check:ipc-generated && npm run check:open-with-policy && npm run check:ipc-schema && npm run check:identity && npm run check:updater && npm run check:workflows && npm run check:provider-surface && npm run check:windows-assets && npm run check:winui-packaging && npm run check:winui-parity-gate",
    "check:rust": "cargo fmt --all -- --check && cargo test --locked --all-features && cargo clippy --locked --all-targets --all-features -- -D warnings",
    "check:security": "node scripts/cargo-audit-release.mjs",
    "check:release": "npm run check && npm run check:rust && npm run check:security",
    "build:winui": "dotnet build src-winui/SimpleFile.sln -c Debug",
    "build:winui:release": "npm run release:build",
    "check:winui": "dotnet test src-winui/SimpleFile.Tests/SimpleFile.Tests.csproj -c Debug --nologo",
    "dev:winui": "cargo build -p simplefile-service && dotnet run --project src-winui/SimpleFile.App/SimpleFile.App.csproj -c Debug",
    "smoke:winui": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-winui-startup.ps1",
    "smoke:winui-file-ops": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-winui-file-ops.ps1",
    "smoke:winui-msi": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-winui-msi.ps1",
    "smoke:winui-installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-winui-nsis.ps1",
    "smoke:winui-upgrade": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-winui-upgrade.ps1 -SkipWhenPreviousUnavailable",
    "smoke:winui-upgrade-from-ref": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-winui-upgrade-from-ref.ps1",
    "release:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-winui-release.ps1",
    "release:local": "npm run check:release && npm run release:build"
  }
}
